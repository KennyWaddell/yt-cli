#!/usr/bin/env bash
# ==============================================================================
# YT-CLI: Lightweight YouTube & Multimedia Client for Low-Resource Linux Systems
# Optimization: Intel Celeron / Atom / 2GB RAM / Hardware Auto-Safe decoding (VA-API, Mesa, NVDEC)
# Backend: yt-dlp + fzf + mpv
# License: GNU General Public License v3.0 (GPLv3)
# ==============================================================================

set -euo pipefail

# ANSI Color Codes
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;90m"
C_BOLD="\033[1m"
C_RESET="\033[0m"

# Binaries resolution (prefer ~/.local/bin, then /usr/bin to bypass Firejail, fallback to PATH)
if [ -x "${HOME}/.local/bin/yt-dlp" ]; then
    BIN_YTDLP="${HOME}/.local/bin/yt-dlp"
elif [ -x "/usr/bin/yt-dlp" ]; then
    BIN_YTDLP="/usr/bin/yt-dlp"
else
    BIN_YTDLP="$(command -v yt-dlp || echo "yt-dlp")"
fi
BIN_FZF="$(command -v fzf || echo "fzf")"
BIN_MPV="$(command -v mpv || echo "mpv")"

# Media target directories (Detect Spanish / English locales automatically)
if [ -d "${HOME}/Descargas" ]; then
    DEFAULT_DIR_VIDEOS="${HOME}/Descargas/Videos"
else
    DEFAULT_DIR_VIDEOS="${HOME}/Downloads/Videos"
fi

if [ -d "${HOME}/Música" ]; then
    DEFAULT_DIR_MUSIC="${HOME}/Música"
elif [ -d "${HOME}/Musica" ]; then
    DEFAULT_DIR_MUSIC="${HOME}/Musica"
else
    DEFAULT_DIR_MUSIC="${HOME}/Music"
fi

CURRENT_DIR_VIDEOS="$DEFAULT_DIR_VIDEOS"
CURRENT_DIR_MUSIC="$DEFAULT_DIR_MUSIC"

mkdir -p "$CURRENT_DIR_VIDEOS" "$CURRENT_DIR_MUSIC" 2>/dev/null || true

# Configuración de Cookies (soporte para navegadores y archivos cookies.txt)
COOKIE_MPV_ARGS=()
COOKIE_YTDL_ARGS=()

set_cookies() {
    local source="$1"
    if [ -f "$source" ]; then
        COOKIE_YTDL_ARGS=("--cookies" "$source")
        COOKIE_MPV_ARGS=("--ytdl-raw-options-append=cookies=${source}")
        echo -e "${C_GREEN}✔ Usando archivo de cookies:${C_RESET} ${source}"
    else
        local browser_lower
        browser_lower=$(echo "$source" | tr '[:upper:]' '[:lower:]')
        COOKIE_YTDL_ARGS=("--cookies-from-browser" "$browser_lower")
        COOKIE_MPV_ARGS=("--ytdl-raw-options-append=cookies-from-browser=${browser_lower}")
        echo -e "${C_GREEN}✔ Usando cookies del navegador:${C_RESET} ${browser_lower}"
    fi
}

# Configuración del Historial local
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/yt-cli"
HISTORY_FILE="${CONFIG_DIR}/history.json"
mkdir -p "$CONFIG_DIR" 2>/dev/null || true

# Guardar elemento en el historial
record_history() {
    local full_title="$1"
    local vid_id="$2"

    python3 - "$HISTORY_FILE" "$full_title" "$vid_id" << 'EOF' 2>/dev/null || true
import sys, json, os, time
path = os.path.expanduser(sys.argv[1])
full_title = sys.argv[2]
vid_id = sys.argv[3]
data = {'enabled': True, 'max_items': 50, 'history': []}
if os.path.isfile(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
    except Exception:
        pass
if data.get('enabled', True):
    hist = [x for x in data.get('history', []) if x.get('id') != vid_id]
    hist.insert(0, {
        'title': full_title,
        'channel': 'YouTube',
        'duration': '--:--',
        'id': vid_id,
        'date': time.strftime('%d/%m/%Y %H:%M')
    })
    data['history'] = hist[:data.get('max_items', 50)]
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
EOF
}

# Ver y seleccionar del historial
show_history_menu() {
    if [ ! -f "$HISTORY_FILE" ]; then
        echo -e "${C_YELLOW}El historial está vacío.${C_RESET}"
        sleep 1.5
        return
    fi

    local hist_list
    hist_list=$(python3 - "$HISTORY_FILE" << 'EOF' 2>/dev/null
import sys, json, os
path = os.path.expanduser(sys.argv[1])
if os.path.isfile(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            d = json.load(f)
            for item in d.get('history', []):
                print(f"{item.get('title','')} [{item.get('date','')}]\t{item.get('id','')}")
    except Exception:
        pass
EOF
)

    if [ -z "$hist_list" ]; then
        echo -e "${C_YELLOW}El historial está vacío.${C_RESET}"
        sleep 1.5
        return
    fi

    hist_list="${hist_list}"$'\n'"🗑️  Borrar todo el historial	__CLEAR_HISTORY__"

    local selection
    selection=$(echo "$hist_list" | "$BIN_FZF" \
        --delimiter='\t' \
        --with-nth=1 \
        --prompt="📜 Historial (máx. 50) > " \
        --header="[Enter] Ver vídeo/playlist o Borrar | [ESC] Volver" \
        --height=60% \
        --reverse \
        --border) || true

    if [ -n "$selection" ]; then
        local id
        id=$(echo "$selection" | awk -F'\t' '{print $2}')
        if [ "$id" = "__CLEAR_HISTORY__" ]; then
            clear_history
            sleep 1.5
            return
        elif [ -n "$id" ]; then
            local url="$id"
            if [[ ! "$id" =~ ^https?:// ]]; then
                url="https://www.youtube.com/watch?v=${id}"
            fi
            choose_action "1"
            case "$SELECTED_ACTION" in
                play_720)   play_videos "720" "$url" ;;
                play_1080)  play_videos "1080" "$url" ;;
                play_480)   play_videos "480" "$url" ;;
                play_audio) play_videos "audio" "$url" ;;
                down_720)   download_videos "720" "$url" ;;
                down_1080)  download_videos "1080" "$url" ;;
                down_mp3)   download_music "$url" ;;
                back|cancel) return ;;
            esac
        fi
    fi
}

# Borrar historial
clear_history() {
    python3 - "$HISTORY_FILE" << 'EOF' 2>/dev/null || true
import sys, json, os
path = os.path.expanduser(sys.argv[1])
if os.path.isfile(path):
    with open(path, 'w', encoding='utf-8') as f:
        json.dump({'enabled': True, 'max_items': 50, 'history': []}, f, indent=2)
EOF
    echo -e "${C_GREEN}✔ Historial de YT-CLI eliminado por completo.${C_RESET}"
}

# Signal trap for clean exit
trap 'echo -e "\n${C_GRAY}Saliendo de YT-CLI... Hasta luego.${C_RESET}"; exit 0' SIGINT SIGTERM

# 1. Dependency validation with guided installation
check_dependencies() {
    local missing=()
    for dep in "$BIN_YTDLP" "$BIN_FZF" "$BIN_MPV"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            missing+=("$dep")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${C_RED}[ERROR]${C_RESET} Faltan dependencias necesarias: ${C_BOLD}${missing[*]}${C_RESET}"
        echo -e "${C_YELLOW}Comando para instalarlas en tu sistema:${C_RESET}"
        if command -v apt >/dev/null 2>&1; then
            echo -e "  ${C_BOLD}sudo apt update && sudo apt install ${missing[*]}${C_RESET}"
        elif command -v pacman >/dev/null 2>&1; then
            echo -e "  ${C_BOLD}sudo pacman -S ${missing[*]}${C_RESET}"
        elif command -v dnf >/dev/null 2>&1; then
            echo -e "  ${C_BOLD}sudo dnf install ${missing[*]}${C_RESET}"
        fi
        exit 1
    fi
}

# 2. Notificación de escritorio nativa (no bloqueante)
notify_user() {
    local title="$1"
    local message="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$message" -i video-television 2>/dev/null || true
    fi
}

# 3. Detección automática de enlaces en el portapapeles (Wayland y X11)
get_clipboard_url() {
    local clip=""
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
        clip=$(wl-paste 2>/dev/null || true)
    elif command -v xclip >/dev/null 2>&1; then
        clip=$(xclip -o -selection clipboard 2>/dev/null || true)
    elif command -v xsel >/dev/null 2>&1; then
        clip=$(xsel --clipboard --output 2>/dev/null || true)
    elif command -v wl-paste >/dev/null 2>&1; then
        clip=$(wl-paste 2>/dev/null || true)
    fi

    # Limpiar espacios
    clip=$(echo "$clip" | xargs 2>/dev/null || echo "$clip")

    if [[ "$clip" =~ ^https?://(www\.|vm\.|vt\.)?(youtube\.com|youtu\.be|tiktok\.com|twitter\.com|x\.com|instagram\.com|vimeo\.com|facebook\.com|reddit\.com|twitch\.tv|soundcloud\.com) ]]; then
        echo "$clip"
    fi
}

# 4. Selector de carpeta de destino interactivo
choose_destination_folder() {
    local type="$1" # "video" o "audio"
    local default_folder="$CURRENT_DIR_VIDEOS"
    [ "$type" = "audio" ] && default_folder="$CURRENT_DIR_MUSIC"

    echo -e "${C_CYAN}Carpeta de destino para descarga:${C_RESET}" >&2
    echo -e "  ${C_BOLD}[1]${C_RESET} Predeterminada: ${C_GREEN}${default_folder}${C_RESET} ${C_YELLOW}★${C_RESET}" >&2

    # Detectar si hay pendrives o discos externos montados en /media/$USER
    local media_dirs=()
    if [ -d "/media/${USER}" ]; then
        while IFS= read -r dir; do
            [ -d "$dir" ] && media_dirs+=("$dir")
        done < <(find "/media/${USER}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
    fi

    local opt_index=2
    if [ ${#media_dirs[@]} -gt 0 ]; then
        for mdir in "${media_dirs[@]}"; do
            echo -e "  ${C_BOLD}[${opt_index}]${C_RESET} Pendrive/Disco externo: ${C_CYAN}${mdir}${C_RESET}" >&2
            opt_index=$((opt_index + 1))
        done
    fi

    echo -e "  ${C_BOLD}[c]${C_RESET} Escribir otra ruta personalizada..." >&2
    echo "" >&2
    echo -ne "${C_YELLOW}Elige opción (Enter para predeterminada): ${C_RESET}" >&2

    local choice=""
    if [ -t 0 ]; then read -r choice || choice="1"; else read -r choice </dev/tty || choice="1"; fi
    [ -z "$choice" ] && choice="1"
    echo "" >&2

    if [ "$choice" = "1" ]; then
        echo "$default_folder"
    elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 2 ] && [ "$choice" -lt "$opt_index" ]; then
        local m_idx=$((choice - 2))
        echo "${media_dirs[$m_idx]}"
    elif [[ "$choice" =~ ^[cC]$ ]]; then
        echo -ne "${C_CYAN}Introduce la ruta de la carpeta: ${C_RESET}" >&2
        local custom_path=""
        if [ -t 0 ]; then read -r custom_path; else read -r custom_path </dev/tty; fi
        custom_path="${custom_path/#\~/$HOME}"
        mkdir -p "$custom_path" 2>/dev/null || true
        echo "$custom_path"
    else
        echo "$default_folder"
    fi
}

SELECTED_ACTION="play_720"

# 5. Menú interactivo unificado (Reproducir / Descargar / Volver)
choose_action() {
    local count="${1:-1}"
    local label_items="este video"
    [ "$count" -gt 1 ] && label_items="${count} videos en cola"

    echo -e "${C_CYAN}¿Qué deseas hacer con ${label_items}?${C_RESET}"
    echo -e "  ${C_BOLD}── REPRODUCIR (STREAMING AL VUELO) ─────────────────${C_RESET}"
    echo -e "  ${C_BOLD}[1]${C_RESET} Ver en 720p HD a 30fps  ${C_GREEN}(Recomendado GPU Auto-Safe)${C_RESET} ${C_YELLOW}★ Predeterminado${C_RESET}"
    echo -e "  ${C_BOLD}[2]${C_RESET} Ver en 1080p Full HD     ${C_GRAY}(30fps acelerado H.264)${C_RESET}"
    echo -e "  ${C_BOLD}[3]${C_RESET} Ver en 480p / 360p       ${C_GRAY}(Ahorro de datos/CPU)${C_RESET}"
    echo -e "  ${C_BOLD}[4]${C_RESET} Escuchar solo audio      ${C_GRAY}(Modo radio/podcast - ~25MB RAM)${C_RESET}"
    echo ""
    echo -e "  ${C_BOLD}── DESCARGAR Y GUARDAR EN DISCO ────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}[5]${C_RESET} Descargar Video(s) 720p  ${C_GRAY}(MP4 H.264 en disco/USB)${C_RESET}"
    echo -e "  ${C_BOLD}[6]${C_RESET} Descargar Video(s) 1080p ${C_GRAY}(MP4 Full HD en disco/USB)${C_RESET}"
    echo -e "  ${C_BOLD}[7]${C_RESET} Descargar Audio(s) MP3   ${C_GRAY}(Con carátula y metadatos)${C_RESET}"
    echo ""
    echo -e "  ${C_BOLD}── NAVEGACIÓN ──────────────────────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}[0]${C_RESET} Volver a la lista / Cancelar"
    echo ""
    echo -ne "${C_YELLOW}Elige opción [1-7 | 0 para volver] (Enter para ver en 720p): ${C_RESET}"

    local user_opt=""
    if [ -t 0 ]; then
        read -r user_opt || user_opt="1"
    else
        read -r user_opt </dev/tty || user_opt="1"
    fi
    [ -z "$user_opt" ] && user_opt="1"
    echo ""

    case "$user_opt" in
        1) SELECTED_ACTION="play_720" ;;
        2) SELECTED_ACTION="play_1080" ;;
        3) SELECTED_ACTION="play_480" ;;
        4|[aA]) SELECTED_ACTION="play_audio" ;;
        5) SELECTED_ACTION="down_720" ;;
        6) SELECTED_ACTION="down_1080" ;;
        7|[mM]) SELECTED_ACTION="down_mp3" ;;
        0|[vV]|[bB]|[qQ]|cancel|cancelar|volver|atras) SELECTED_ACTION="back" ;;
        *) SELECTED_ACTION="play_720" ;;
    esac
}

# 6. Reproducción optimizada en MPV (con soporte para colas múltiples)
play_videos() {
    local quality="$1"
    shift
    local targets=("$@")

    local MPV_ARGS=(
        "--script-opts=ytdl_hook-ytdl_path=${BIN_YTDLP}"
        "--msg-level=all=no,statusline=status"
        "--save-position-on-quit"
        "--watch-later-options=start"
        "--ytdl-raw-options-append=extractor-args=youtube:lang=es"
    )
    if [ ${#COOKIE_MPV_ARGS[@]} -gt 0 ]; then
        MPV_ARGS+=("${COOKIE_MPV_ARGS[@]}")
    fi

    if [ "$quality" = "audio" ]; then
        echo -e "${C_CYAN}▶ Modo Solo Audio (Reproductor compacto interactivo - ~25 MB RAM)...${C_RESET}"
        echo -e "${C_YELLOW}⏳ Cargando audio/playlist... la ventana de controles abrirá en unos segundos.${C_RESET}"
        MPV_ARGS+=(
            "--title=YT-CLI - Reproductor de Audio"
            "--vid=no"
            "--force-window=yes"
            "--geometry=560x220"
            "--player-operation-mode=pseudo-gui"
            "--ytdl-format=bestaudio[ext=m4a]/bestaudio/best"
        )
    else
        local ytdl_fmt=""
        case "$quality" in
            360)
                echo -e "${C_CYAN}▶ Reproduciendo en 360p (H.264 / 30fps)...${C_RESET}"
                ytdl_fmt="bestvideo[vcodec^=avc1][height<=360][fps<=30]+bestaudio/best[vcodec^=avc1][height<=360]/best[height<=360]/best"
                ;;
            480)
                echo -e "${C_CYAN}▶ Reproduciendo en 480p (H.264 / 30fps)...${C_RESET}"
                ytdl_fmt="bestvideo[vcodec^=avc1][height<=480][fps<=30]+bestaudio/best[vcodec^=avc1][height<=480]/best[height<=480]/best"
                ;;
            1080)
                echo -e "${C_CYAN}▶ Reproduciendo en 1080p a 30fps (H.264 / auto-safe, fallback 720p)...${C_RESET}"
                ytdl_fmt="bestvideo[vcodec^=avc1][height<=1080][fps<=30]+bestaudio/bestvideo[vcodec^=avc1][height<=720][fps<=30]+bestaudio/best[vcodec^=avc1][height<=1080]/best[vcodec^=avc1][height<=720]/best[height<=720]/best"
                ;;
            720|*)
                echo -e "${C_CYAN}▶ Reproduciendo en 720p (H.264 / auto-safe)...${C_RESET}"
                ytdl_fmt="bestvideo[vcodec^=avc1][height<=720][fps<=30]+bestaudio/best[vcodec^=avc1][height<=720]/best[height<=720]/best"
                ;;
        esac

        MPV_ARGS+=(
            "--hwdec=auto-safe"
            "--vo=gpu"
            "--ytdl-format=${ytdl_fmt}"
        )
    fi

    # Formatear URLs con prefijo ytdl://
    local formatted_urls=()
    for t in "${targets[@]}"; do
        if [[ "$t" =~ ^https?:// ]]; then
            formatted_urls+=("ytdl://${t}")
        else
            formatted_urls+=("$t")
        fi
    done

    if [ "$quality" = "audio" ]; then
        echo -e "${C_GRAY}[Atajos Audio: 'Espacio' pausa | '←/→' retroceder/avanzar | 'l' bucle | '>/< ' sig./ant. | '9/0' vol | 'q' salir]${C_RESET}\n"
    elif [ ${#formatted_urls[@]} -gt 1 ]; then
        echo -e "${C_GREEN}🎶 Cola activa con ${#formatted_urls[@]} elementos.${C_RESET}"
        echo -e "${C_GRAY}[Atajos MPV: '>' siguiente | '<' anterior | 'q' salir | 'Espacio' pausa | 'f' pantalla completa]${C_RESET}\n"
    else
        echo -e "${C_GRAY}[Atajos MPV: 'q' cerrar y volver a lista | 'Espacio' pausa | '9/0' volumen | 'f' pantalla completa]${C_RESET}\n"
    fi

    "$BIN_MPV" "${MPV_ARGS[@]}" "${formatted_urls[@]}" || true
    echo ""
}

# 7. Descarga optimizada de video (MP4 / H.264 / Reanudación)
download_videos() {
    local height="$1"
    shift
    local targets=("$@")

    local dest_dir
    dest_dir=$(choose_destination_folder "video")
    mkdir -p "$dest_dir" 2>/dev/null || true

    echo -e "${C_CYAN}⬇ Descargando Video(s) en ${height}p (H.264 compatible / Reanudación activa)...${C_RESET}"
    echo -e "${C_GRAY}Guardando en: ${dest_dir}/${C_RESET}\n"

    local ytdl_fmt="bestvideo[vcodec^=avc1][height<=${height}][fps<=30]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc1][height<=${height}][fps<=30]+bestaudio/best[height<=${height}]/best"

    local has_error=0
    for t in "${targets[@]}"; do
        if ! "$BIN_YTDLP" \
            ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
            -c \
            -f "${ytdl_fmt}" \
            --merge-output-format mp4 \
            --embed-thumbnail \
            --embed-metadata \
            --no-warnings \
            -o "${dest_dir}/%(title)s.%(ext)s" \
            "$t"; then
            has_error=1
        fi
    done

    if [ "$has_error" -eq 0 ]; then
        echo -e "\n${C_GREEN}✔ Descarga de video finalizada con éxito.${C_RESET}"
        notify_user "YT-CLI" "Descarga de video completada en ${dest_dir}"
    else
        echo -e "\n${C_RED}✖ La descarga falló. Revisa el error arriba (si es TikTok/restringido, prueba con cookies usando :c o actualiza yt-dlp).${C_RESET}"
    fi

    echo -ne "${C_YELLOW}Presione [Enter] para volver a la lista...${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 8. Descarga optimizada de música (MP3 / Reanudación / Playlists)
download_music() {
    local targets=("$@")

    echo -e "${C_CYAN}Calidad de audio para MP3:${C_RESET}"
    echo -e "  ${C_BOLD}[1]${C_RESET} 320 kbps  ${C_GREEN}(Máxima fidelidad)${C_RESET} ${C_YELLOW}★ Predeterminado${C_RESET}"
    echo -e "  ${C_BOLD}[2]${C_RESET} 192 kbps  ${C_GRAY}(Balance calidad y tamaño)${C_RESET}"
    echo -e "  ${C_BOLD}[3]${C_RESET} 128 kbps  ${C_GRAY}(Ahorro de espacio / Ideal para playlists)${C_RESET}"
    echo ""
    echo -ne "${C_YELLOW}Elige calidad [1-3] (Enter para 320k): ${C_RESET}"

    local user_opt=""
    if [ -t 0 ]; then read -r user_opt || user_opt="1"; else read -r user_opt </dev/tty || user_opt="1"; fi
    [ -z "$user_opt" ] && user_opt="1"
    echo ""

    local bitrate="320"
    case "$user_opt" in
        2) bitrate="192" ;;
        3) bitrate="128" ;;
        *) bitrate="320" ;;
    esac

    echo -ne "${C_CYAN}¿Incrustar carátula en los MP3? [S/n] (Enter para Sí): ${C_RESET}"
    local user_cover=""
    if [ -t 0 ]; then read -r user_cover || user_cover="s"; else read -r user_cover </dev/tty || user_cover="s"; fi
    [ -z "$user_cover" ] && user_cover="s"
    echo ""

    local EXTRA_ARGS=()
    if [[ "$user_cover" =~ ^[nN]$ ]]; then
        echo -e "${C_YELLOW}⚡ Modo rápido: Se omitirá la carátula para máxima velocidad.${C_RESET}"
    else
        EXTRA_ARGS+=("--embed-thumbnail")
        echo -e "${C_GREEN}✔ Se incrustará la carátula oficial en cada archivo.${C_RESET}"
    fi

    local dest_dir
    dest_dir=$(choose_destination_folder "audio")
    mkdir -p "$dest_dir" 2>/dev/null || true

    echo -e "${C_CYAN}⬇ Descargando audio en MP3 a ${bitrate} kbps (Reanudación activa)...${C_RESET}"
    echo -e "${C_GRAY}Guardando en: ${dest_dir}/${C_RESET}\n"

    local has_error=0
    for t in "${targets[@]}"; do
        if ! "$BIN_YTDLP" \
            ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
            -c \
            --extract-audio \
            --audio-format mp3 \
            --audio-quality "${bitrate}k" \
            "${EXTRA_ARGS[@]}" \
            --embed-metadata \
            --no-warnings \
            -o "${dest_dir}/%(playlist_title&{}/|)s%(title)s.%(ext)s" \
            "$t"; then
            has_error=1
        fi
    done

    if [ "$has_error" -eq 0 ]; then
        echo -e "\n${C_GREEN}✔ Descarga de audio finalizada con éxito.${C_RESET}"
        notify_user "YT-CLI" "Descarga de canciones completada en ${dest_dir}"
    else
        echo -e "\n${C_RED}✖ La descarga de audio falló. Revisa el error arriba.${C_RESET}"
    fi

    echo -ne "${C_YELLOW}Presione [Enter] para volver a la lista...${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 9. Flujo interactivo de búsqueda y cola con FZF (Multi-select)
search_and_play() {
    local query="$1"
    local forced_mode="${2:-ask}"

    local search_args=()
    if [[ "$query" =~ ^@([a-zA-Z0-9_.-]+)[[:space:]]+(.+)$ ]]; then
        local ch="${BASH_REMATCH[1]}"
        local term="${BASH_REMATCH[2]}"
        echo -ne "${C_YELLOW}Buscando en canal @${ch}:${C_RESET} \"${C_BOLD}${term}${C_RESET}\"... \r"
        search_args=("https://www.youtube.com/@${ch}/search?query=${term}" "--playlist-end" "25")
    elif [[ "$query" =~ ^@([a-zA-Z0-9_.-]+)$ ]]; then
        local ch="${BASH_REMATCH[1]}"
        echo -ne "${C_YELLOW}Obteniendo videos del canal @${ch}...${C_RESET} \r"
        search_args=("https://www.youtube.com/@${ch}/videos" "--playlist-end" "25")
    else
        echo -ne "${C_YELLOW}Buscando en YouTube:${C_RESET} \"${C_BOLD}${query}${C_RESET}\"... \r"
        search_args=("ytsearch25:${query}")
    fi

    local search_results
    search_results=$("$BIN_YTDLP" \
        ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
        "${search_args[@]}" \
        --flat-playlist \
        --skip-download \
        --no-warnings \
        --extractor-args "youtube:lang=es" \
        --print "%(title)s [%(duration_string)s - %(uploader)s]	%(id)s" 2>/dev/null) || true

    if [ -z "$search_results" ]; then
        echo -e "${C_RED}No se encontraron resultados para:${C_RESET} \"$query\""
        return
    fi

    while true; do
        echo -ne "\033[2K\r"

        local raw_selection
        raw_selection=$(echo "$search_results" | "$BIN_FZF" \
            --delimiter='\t' \
            --with-nth=1 \
            --multi \
            --prompt="▶ Selecciona video(s) > " \
            --header="[Enter] Ver | [Tab] Marcar varios | [ESC] Salir | [Flechas] Navegar" \
            --height=70% \
            --reverse \
            --border \
            --info=inline) || true

        if [ -z "$raw_selection" ]; then
            echo -e "${C_GRAY}Saliendo de la lista actual de resultados...${C_RESET}"
            break
        fi

        # Extraer URLs de los elementos seleccionados
        local selected_urls=()
        local selected_count=0
        while IFS=$'\t' read -r title id; do
            if [ -n "$id" ]; then
                selected_urls+=("https://www.youtube.com/watch?v=${id}")
                record_history "$title" "$id"
                selected_count=$((selected_count + 1))
            fi
        done <<< "$raw_selection"

        echo -e "\n${C_GREEN}✔ Elementos seleccionados:${C_RESET} ${C_BOLD}${selected_count}${C_RESET}\n"

        if [ "$forced_mode" = "ask" ]; then
            choose_action "$selected_count"
            case "$SELECTED_ACTION" in
                play_720)   play_videos "720" "${selected_urls[@]}" ;;
                play_1080)  play_videos "1080" "${selected_urls[@]}" ;;
                play_480)   play_videos "480" "${selected_urls[@]}" ;;
                play_audio) play_videos "audio" "${selected_urls[@]}" ;;
                down_720)   download_videos "720" "${selected_urls[@]}" ;;
                down_1080)  download_videos "1080" "${selected_urls[@]}" ;;
                down_mp3)   download_music "${selected_urls[@]}" ;;
                back|cancel) continue ;;
            esac
        else
            play_videos "$forced_mode" "${selected_urls[@]}"
        fi
    done
}

# Guardar enlace directo/playlist en historial y mostrar menú de acciones
handle_direct_url() {
    local target_url="$1"
    local label="Enlace: ${target_url}"
    if [[ "$target_url" == *"list="* ]]; then
        label="Playlist: ${target_url}"
    fi
    record_history "$label" "$target_url"

    choose_action "1"
    case "$SELECTED_ACTION" in
        play_720)   play_videos "720" "$target_url" ;;
        play_1080)  play_videos "1080" "$target_url" ;;
        play_480)   play_videos "480" "$target_url" ;;
        play_audio) play_videos "audio" "$target_url" ;;
        down_720)   download_videos "720" "$target_url" ;;
        down_1080)  download_videos "1080" "$target_url" ;;
        down_mp3)   download_music "$target_url" ;;
        back|cancel) return ;;
    esac
}

# 10. Banner principal
show_banner() {
    clear
    echo -e "${C_CYAN}  ██╗   ██╗████████╗      ██████╗██╗     ██╗${C_RESET}"
    echo -e "${C_CYAN}  ╚██╗ ██╔╝╚══██╔══╝     ██╔════╝██║     ██║${C_RESET}"
    echo -e "${C_CYAN}   ╚████╔╝    ██║  █████╗██║     ██║     ██║${C_RESET}"
    echo -e "${C_CYAN}    ╚██╔╝     ██║  ╚════╝██║     ██║     ██║${C_RESET}"
    echo -e "${C_CYAN}     ██║      ██║        ╚██████╗███████╗██║${C_RESET}"
    echo -e "${C_GRAY}  ────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}Cliente Multimedia: YouTube, TikTok, X, Reels y +1000 sitios${C_RESET}"
    echo -e "  ${C_GRAY}Aceleración HWDEC Auto • Cola FZF • Descargas MP4/MP3${C_RESET}"
    echo -e "  ${C_YELLOW}Búsquedas: término | @canal | @canal término | enlaces URL${C_RESET}"
    echo -e "  ${C_YELLOW}Comandos:  [:help] Ayuda  [:h] Historial  [:c] Cookies  [q] Salir${C_RESET}"
    echo -e "${C_GRAY}  ────────────────────────────────────────────────────────────${C_RESET}\n"
}

# 10b. Ayuda interactiva rápida
show_interactive_help() {
    clear
    echo -e "${C_CYAN}================================================================${C_RESET}"
    echo -e "${C_BOLD}                   GUÍA RÁPIDA DE COMANDOS (YT-CLI)${C_RESET}"
    echo -e "${C_CYAN}================================================================${C_RESET}\n"
    echo -e "  ${C_YELLOW}Búsquedas y Enlaces:${C_RESET}"
    echo -e "    ${C_GREEN}palabras clave${C_RESET}     Búsqueda general en YouTube (ej: noticias de hoy)"
    echo -e "    ${C_GREEN}@canal${C_RESET}             Ver videos recientes de un canal (ej: @ElCuriosoBen)"
    echo -e "    ${C_GREEN}@canal término${C_RESET}     Buscar dentro de un canal (ej: @DrossRotzank misterio)"
    echo -e "    ${C_GREEN}https://...${C_RESET}        Pega enlaces de YouTube, TikTok, X, Reels, etc.\n"
    echo -e "  ${C_YELLOW}Comandos en la consola interactiva:${C_RESET}"
    echo -e "    ${C_GREEN}:help${C_RESET} o ${C_GREEN}:?${C_RESET}        Muestra este resumen de ayuda"
    echo -e "    ${C_GREEN}:h${C_RESET}                 Abre el historial interactivo de reproducción"
    echo -e "    ${C_GREEN}:clear${C_RESET}             Borra todo el historial local guardado"
    echo -e "    ${C_GREEN}:c${C_RESET}                 Activa cookies de navegador (Brave, Firefox, etc.)"
    echo -e "    ${C_GREEN}q${C_RESET} o ${C_GREEN}salir${C_RESET}          Cierra YT-CLI\n"
    echo -e "  ${C_YELLOW}Opciones al arrancar desde terminal externa:${C_RESET}"
    echo -e "    ${C_CYAN}yt-cli -a <query/url>${C_RESET}    Modo podcast (Solo audio, ~25 MB RAM)"
    echo -e "    ${C_CYAN}yt-cli -d <query/url>${C_RESET}    Descargar directamente en MP4 (720p H.264)"
    echo -e "    ${C_CYAN}yt-cli -m <query/url>${C_RESET}    Descargar canción directamente en MP3 (320k)"
    echo -e "    ${C_CYAN}yt-cli -H${C_RESET}                Abrir historial directamente"
    echo -e "    ${C_CYAN}yt-cli -h${C_RESET}                Ver todos los flags de ejecución\n"
    echo -e "${C_CYAN}================================================================${C_RESET}"
    echo -ne "${C_GRAY}Presiona [Enter] para volver al menú principal...${C_RESET}"
    local _dummy=""
    if [ -t 0 ]; then read -r _dummy; else read -r _dummy </dev/tty; fi
}

# 11. Punto de entrada principal
main() {
    check_dependencies

    # Procesar argumentos por línea de comandos
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                echo "Uso: yt-cli [OPCIONES] [BÚSQUEDA o ENLACE]"
                echo ""
                echo "Opciones:"
                echo "  -c, --cookies [navegador/ruta] Usar cookies para contenido restringido (ej: brave, firefox, cookies.txt)"
                echo "  -a, --audio [query/url]       Reproducir solo el audio (Modo podcast)"
                echo "  -d, --download [query/url]    Descargar video directamente en 720p MP4"
                echo "  -m, --music [query/url]       Descargar canción directamente en MP3 320k"
                echo "  -H, --history                 Abrir el historial de vídeos vistos"
                echo "      --clear-history           Borrar todo el historial guardado"
                echo "  -h, --help                    Mostrar esta ayuda"
                echo ""
                echo "Ejemplos:"
                echo "  yt-cli                        Modo interactivo completo (con autodetección de portapapeles)"
                echo "  yt-cli \"@ElCuriosoBen\"        Ver videos recientes de un canal"
                echo "  yt-cli \"@DrossRotzank terror\" Buscar dentro de un canal específico"
                echo "  yt-cli -c brave               Iniciar modo interactivo con cookies de Brave"
                echo "  yt-cli -c brave \"video 18+\"   Buscar con cookies de sesión activadas"
                echo "  yt-cli -H                     Abrir el historial para reanudar cualquier vídeo"
                echo "  yt-cli \"noticias\"            Buscar directamente y elegir del menú"
                echo "  yt-cli -m \"linkin park\"       Buscar y descargar en MP3 directo a tu carpeta Música"
                echo "  yt-cli https://youtu.be/...   Opciones directas para un enlace"
                exit 0
                ;;
            -c|--cookies)
                if [ $# -gt 1 ]; then
                    set_cookies "$2"
                    shift 2
                else
                    echo -e "${C_RED}[ERROR]${C_RESET} Debes indicar un navegador o ruta a cookies (ej: -c brave, -c firefox, -c cookies.txt)"
                    exit 1
                fi
                ;;
            -H|--history)
                show_history_menu
                exit 0
                ;;
            --clear-history)
                clear_history
                exit 0
                ;;
            -a|--audio)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        play_videos "audio" "$target"
                    else
                        search_and_play "$target" "audio"
                    fi
                else
                    show_banner
                    echo -ne "${C_CYAN}Buscar en YouTube (Solo Audio): ${C_RESET}"
                    read -r query
                    [ -n "$query" ] && search_and_play "$query" "audio"
                fi
                exit 0
                ;;
            -m|--music)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_music "$target"
                    else
                        search_and_play "$target" "ask"
                    fi
                fi
                exit 0
                ;;
            -d|--download)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_videos "720" "$target"
                    else
                        search_and_play "$target" "ask"
                    fi
                fi
                exit 0
                ;;
            *)
                local target="$*"
                if [[ "$target" =~ ^https?:// ]]; then
                    handle_direct_url "$target"
                    exit 0
                else
                    search_and_play "$target" "ask"
                    exit 0
                fi
                ;;
        esac
    done

    # Comprobar si hay un enlace multimedia en el portapapeles al iniciar
    local clipboard_url
    clipboard_url=$(get_clipboard_url)
    if [ -n "$clipboard_url" ]; then
        show_banner
        echo -e "${C_GREEN}📋 Enlace detectado en el portapapeles:${C_RESET}"
        echo -e "   ${C_CYAN}${clipboard_url}${C_RESET}\n"
        echo -ne "${C_YELLOW}¿Deseas abrir este enlace? [S/n] (Enter para Sí): ${C_RESET}"
        local use_clip=""
        if [ -t 0 ]; then read -r use_clip || use_clip="s"; else read -r use_clip </dev/tty || use_clip="s"; fi
        [ -z "$use_clip" ] && use_clip="s"
        echo ""

        if [[ "$use_clip" =~ ^[sSyY]$ ]]; then
            handle_direct_url "$clipboard_url"
        fi
    fi

    # Bucle interactivo normal
    while true; do
        show_banner
        echo -ne "${C_CYAN}Buscar, pegar enlace o comando [:help | :h | @canal | q]: ${C_RESET}"
        read -r query

        if [ -z "$query" ]; then
            continue
        fi

        if [[ "$query" == "q" || "$query" == "exit" || "$query" == "salir" ]]; then
            echo -e "${C_GRAY}Hasta luego.${C_RESET}"
            break
        fi

        if [[ "$query" == ":help" || "$query" == ":?" || "$query" == "help" || "$query" == "ayuda" || "$query" == ":ayuda" ]]; then
            show_interactive_help
            continue
        fi

        if [[ "$query" == ":h" || "$query" == "historial" || "$query" == "history" ]]; then
            show_history_menu
            continue
        fi

        if [[ "$query" == ":clear" || "$query" == "borrar" || "$query" == "clear-history" ]]; then
            clear_history
            sleep 1.5
            continue
        fi

        if [[ "$query" == ":c" || "$query" == "cookies" ]]; then
            echo -ne "${C_CYAN}Introduce navegador o ruta a cookies (ej: brave, firefox, cookies.txt): ${C_RESET}"
            read -r c_input
            if [ -n "$c_input" ]; then
                set_cookies "$c_input"
                sleep 1.2
            fi
            continue
        fi

        if [[ "$query" =~ ^https?:// ]]; then
            handle_direct_url "$query"
        else
            search_and_play "$query" "ask"
        fi

        echo -ne "\n${C_YELLOW}¿Presione [Enter] para otra búsqueda o [q] para salir: ${C_RESET}"
        read -r next_action
        if [[ "$next_action" == "q" || "$next_action" == "exit" ]]; then
            break
        fi
    done
}

main "$@"
