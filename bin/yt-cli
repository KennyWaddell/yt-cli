#!/usr/bin/env bash
# ==============================================================================
# YT-CLI: Lightweight YouTube & Multimedia Client for Low-Resource Linux Systems
# Optimization: Intel Celeron / Atom / 2GB RAM / Hardware Auto-Safe decoding (VA-API, Mesa, NVDEC)
# Backend: yt-dlp + fzf + mpv
# License: GNU General Public License v3.0 (GPLv3)
# ==============================================================================

set -euo pipefail

# ANSI Color Codes
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;90m"
C_BOLD="\033[1m"
C_RESET="\033[0m"

# Binaries resolution (prefer ~/.local/bin, then /usr/bin to bypass Firejail, fallback to PATH)
if [ -x "${HOME}/.local/bin/yt-dlp" ]; then
    BIN_YTDLP="${HOME}/.local/bin/yt-dlp"
elif [ -x "/usr/bin/yt-dlp" ]; then
    BIN_YTDLP="/usr/bin/yt-dlp"
else
    BIN_YTDLP="$(command -v yt-dlp || echo "yt-dlp")"
fi
BIN_FZF="$(command -v fzf || echo "fzf")"
BIN_MPV="$(command -v mpv || echo "mpv")"

# Media target directories (Detect Spanish / English locales automatically)
if [ -d "${HOME}/Descargas" ]; then
    DEFAULT_DIR_VIDEOS="${HOME}/Descargas/Videos"
else
    DEFAULT_DIR_VIDEOS="${HOME}/Downloads/Videos"
fi

if [ -d "${HOME}/Música" ]; then
    DEFAULT_DIR_MUSIC="${HOME}/Música"
elif [ -d "${HOME}/Musica" ]; then
    DEFAULT_DIR_MUSIC="${HOME}/Musica"
else
    DEFAULT_DIR_MUSIC="${HOME}/Music"
fi

if [ -d "${HOME}/Documentos" ]; then
    DEFAULT_DIR_DOCS="${HOME}/Documentos"
else
    DEFAULT_DIR_DOCS="${HOME}/Documents"
fi

CURRENT_DIR_VIDEOS="$DEFAULT_DIR_VIDEOS"
CURRENT_DIR_MUSIC="$DEFAULT_DIR_MUSIC"
CURRENT_DIR_DOCS="$DEFAULT_DIR_DOCS"

mkdir -p "$CURRENT_DIR_VIDEOS" "$CURRENT_DIR_MUSIC" "$CURRENT_DIR_DOCS" 2>/dev/null || true

# Configuración de Cookies (soporte para navegadores y archivos cookies.txt)
COOKIE_MPV_ARGS=()
COOKIE_YTDL_ARGS=()

set_cookies() {
    local source="$1"
    if [ -f "$source" ]; then
        COOKIE_YTDL_ARGS=("--cookies" "$source")
        COOKIE_MPV_ARGS=("--ytdl-raw-options-append=cookies=${source}")
        echo -e "${C_GREEN}${MSG_COOKIE_SUCCESS:-✔ Cookies configuradas para:}${C_RESET} ${source}"
    else
        local browser_lower
        browser_lower=$(echo "$source" | tr '[:upper:]' '[:lower:]')
        COOKIE_YTDL_ARGS=("--cookies-from-browser" "$browser_lower")
        COOKIE_MPV_ARGS=("--ytdl-raw-options-append=cookies-from-browser=${browser_lower}")
        echo -e "${C_GREEN}${MSG_COOKIE_SUCCESS:-✔ Cookies configuradas para:}${C_RESET} ${browser_lower}"
    fi
}

# Configuración del Historial y Entorno local
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/yt-cli"
HISTORY_FILE="${CONFIG_DIR}/history.json"
ARCHIVE_FILE="${CONFIG_DIR}/download_archive.txt"
CONFIG_FILE="${CONFIG_DIR}/config"
mkdir -p "$CONFIG_DIR" 2>/dev/null || true

# Plantilla y lectura de opciones avanzadas para power-users
EXTRA_YTDL_ARGS=()
FILTER_ARGS=()

ensure_config_file() {
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    if [ ! -f "$CONFIG_FILE" ] && [ -w "$CONFIG_DIR" ]; then
        cat << 'EOF' > "$CONFIG_FILE" 2>/dev/null || true
# ==============================================================================
# YT-CLI Configuration File
# ==============================================================================

# Interface Language (es | en)
# CLI_LANG="es"

# --- ADVANCED OPTIONS (For power users) ---
# Multi-connection download accelerator (requires aria2 package: sudo apt install aria2)
# ENABLE_ARIA2=false
# ARIA2_CONNECTIONS=8

# Network retries for unstable connections
# RETRY_WAIT=5
# FRAGMENT_RETRIES=10

# Skip sponsored segments automatically on downloads (SponsorBlock)
# SPONSORBLOCK=false
# SPONSORBLOCK_CATS="sponsor,selfpromo"
# SPONSORBLOCK_MARK=false

# Maximum framerate limit (30 | 60 | auto)
# MAX_FPS=30

# Default search result limit (1-200)
# SEARCH_LIMIT=25
EOF
    fi
}
ensure_config_file

MAX_FPS="30"
SPONSORBLOCK_CATS="sponsor,selfpromo"
SPONSORBLOCK_MARK="false"
SEARCH_LIMIT="25"
DURATION_FILTER_EXPR=""
DURATION_FILTER_LABEL=""

if [ -f "$CONFIG_FILE" ]; then
    if grep -Eq '^[[:space:]]*SEARCH_LIMIT=' "$CONFIG_FILE" 2>/dev/null; then
        cfg_limit=$(grep -E '^[[:space:]]*SEARCH_LIMIT=' "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d '"'\'' ' || true)
        if [[ "$cfg_limit" =~ ^[0-9]+$ ]] && [ "$cfg_limit" -ge 1 ] && [ "$cfg_limit" -le 200 ]; then
            SEARCH_LIMIT="$cfg_limit"
        fi
    fi
    if grep -Eq '^[[:space:]]*ENABLE_ARIA2=(true|1)' "$CONFIG_FILE" 2>/dev/null; then
        if command -v aria2c >/dev/null 2>&1; then
            aria2_conns=$(grep -E '^[[:space:]]*ARIA2_CONNECTIONS=' "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d '"'\'' ' || true)
            [ -z "$aria2_conns" ] && aria2_conns="8"
            EXTRA_YTDL_ARGS+=("--downloader" "aria2c" "--downloader-args" "aria2c:-s ${aria2_conns} -x ${aria2_conns} -k 1M")
        fi
    fi
    if grep -Eq '^[[:space:]]*RETRY_WAIT=' "$CONFIG_FILE" 2>/dev/null; then
        r_wait=$(grep -E '^[[:space:]]*RETRY_WAIT=' "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d '"'\'' ' || true)
        [ -n "$r_wait" ] && EXTRA_YTDL_ARGS+=("--retry-wait" "$r_wait")
    fi
    if grep -Eq '^[[:space:]]*MAX_FPS=' "$CONFIG_FILE" 2>/dev/null; then
        cfg_fps=$(grep -E '^[[:space:]]*MAX_FPS=' "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d '"'\'' ' || true)
        [ -n "$cfg_fps" ] && MAX_FPS="${cfg_fps,,}"
    fi
    if grep -Eq '^[[:space:]]*SPONSORBLOCK_CATS=' "$CONFIG_FILE" 2>/dev/null; then
        cfg_cats=$(grep -E '^[[:space:]]*SPONSORBLOCK_CATS=' "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d '"'\'' ' || true)
        [ -n "$cfg_cats" ] && SPONSORBLOCK_CATS="$cfg_cats"
    fi
    if grep -Eq '^[[:space:]]*SPONSORBLOCK=(true|1)' "$CONFIG_FILE" 2>/dev/null; then
        EXTRA_YTDL_ARGS+=("--sponsorblock-remove" "$SPONSORBLOCK_CATS")
    fi
    if grep -Eq '^[[:space:]]*SPONSORBLOCK_MARK=(true|1)' "$CONFIG_FILE" 2>/dev/null; then
        SPONSORBLOCK_MARK="true"
    fi
fi

# Reiniciar registro de descargas previas (archive)
clear_download_archive() {
    if [ -f "$ARCHIVE_FILE" ]; then
        rm -f "$ARCHIVE_FILE"
    fi
    echo -e "${C_GREEN}${MSG_ARCHIVE_CLEARED:-✔ Registro de descargas previas reiniciado correctamente.}${C_RESET}"
}

# Convertir expresión de duración (ej: 5m, 1h, 1h30m, 90s, 300) a segundos
parse_duration_to_seconds() {
    local raw="${1,,}"
    raw="${raw// /}"
    if [[ "$raw" =~ ^([0-9]+)h([0-9]+)m$ ]]; then
        echo $(( ${BASH_REMATCH[1]} * 3600 + ${BASH_REMATCH[2]} * 60 ))
        return 0
    elif [[ "$raw" =~ ^([0-9]+)h$ ]]; then
        echo $(( ${BASH_REMATCH[1]} * 3600 ))
        return 0
    elif [[ "$raw" =~ ^([0-9]+)m$ ]]; then
        echo $(( ${BASH_REMATCH[1]} * 60 ))
        return 0
    elif [[ "$raw" =~ ^([0-9]+)s?$ ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}

# Configurar límite de resultados por búsqueda (1-200)
set_search_limit() {
    local val="${1:-}"
    val="${val// /}"

    if [ -z "$val" ]; then
        echo -e "\n${C_CYAN}${MSG_LIMIT_MENU_TITLE:-Límite actual de resultados:} ${C_BOLD}${SEARCH_LIMIT}${C_RESET}"
        echo -e "  ${C_GREEN}[1]${C_RESET} 25  ${C_GRAY}(${MSG_LIMIT_OPT_25:-rápido, por defecto})${C_RESET}"
        echo -e "  ${C_GREEN}[2]${C_RESET} 50  ${C_GRAY}(${MSG_LIMIT_OPT_50:-medio})${C_RESET}"
        echo -e "  ${C_GREEN}[3]${C_RESET} 100 ${C_GRAY}(${MSG_LIMIT_OPT_100:-amplio, ideal con filtros de duración})${C_RESET}"
        echo -e "  ${C_GREEN}[4]${C_RESET} ${MSG_LIMIT_OPT_CUSTOM:-Cantidad personalizada (1-200)}"
        echo -ne "${C_CYAN}${MSG_LIMIT_CHOOSE:-Elige opción [1-4]: }${C_RESET}"
        local choice=""
        read -r choice || true
        case "$choice" in
            1) val="25" ;;
            2) val="50" ;;
            3) val="100" ;;
            4)
                echo -ne "${C_CYAN}${MSG_LIMIT_ENTER:-Introduce cantidad (1-200): }${C_RESET}"
                read -r val || true
                ;;
            *) return 0 ;;
        esac
    fi

    if [[ "$val" =~ ^[0-9]+$ ]] && [ "$val" -ge 1 ] && [ "$val" -le 200 ]; then
        SEARCH_LIMIT="$val"
        echo -e "${C_GREEN}✔ ${MSG_LIMIT_SET:-Límite de resultados ajustado a:} ${C_BOLD}${SEARCH_LIMIT}${C_RESET}"
    else
        echo -e "${C_RED}[ERROR]${C_RESET} ${MSG_LIMIT_INVALID:-Indica un número válido entre 1 y 200 (ej: :limit 100).}"
    fi
}

# Configurar filtro de duración (>5m, >15m, >1h, <10m, off)
set_duration_filter() {
    local arg="${1:-}"
    arg="${arg// /}"
    arg="${arg,,}"

    if [ -z "$arg" ]; then
        local current_disp="${DURATION_FILTER_LABEL:-${MSG_FILTER_NONE:-Todas}}"
        echo -e "\n${C_CYAN}${MSG_DUR_MENU_TITLE:-Filtro de duración actual:} ${C_BOLD}${current_disp}${C_RESET}"
        echo -e "  ${C_GREEN}[1]${C_RESET} >= 5m   ${C_GRAY}(${MSG_DUR_OPT_5M:-más de 5 minutos})${C_RESET}"
        echo -e "  ${C_GREEN}[2]${C_RESET} >= 15m  ${C_GRAY}(${MSG_DUR_OPT_15M:-más de 15 minutos})${C_RESET}"
        echo -e "  ${C_GREEN}[3]${C_RESET} >= 30m  ${C_GRAY}(${MSG_DUR_OPT_30M:-más de 30 minutos})${C_RESET}"
        echo -e "  ${C_GREEN}[4]${C_RESET} >= 1h   ${C_GRAY}(${MSG_DUR_OPT_1H:-más de 1 hora})${C_RESET}"
        echo -e "  ${C_GREEN}[5]${C_RESET} <= 10m  ${C_GRAY}(${MSG_DUR_OPT_SHORT:-menos de 10 minutos})${C_RESET}"
        echo -e "  ${C_GREEN}[6]${C_RESET} ${MSG_DUR_OPT_CUSTOM:-Personalizado (ej: >20m, <5m, >1h30m)}"
        echo -e "  ${C_GREEN}[0]${C_RESET} ${MSG_DUR_OPT_OFF:-Quitar filtro (mostrar todos)}"
        echo -ne "${C_CYAN}${MSG_DUR_CHOOSE:-Elige opción [0-6]: }${C_RESET}"
        local choice=""
        read -r choice || true
        case "$choice" in
            1) arg=">5m" ;;
            2) arg=">15m" ;;
            3) arg=">30m" ;;
            4) arg=">1h" ;;
            5) arg="<10m" ;;
            6)
                echo -ne "${C_CYAN}${MSG_DUR_ENTER:-Introduce filtro (ej: >5m, >1h, <10m, off): }${C_RESET}"
                read -r arg || true
                arg="${arg// /}"
                arg="${arg,,}"
                ;;
            0) arg="off" ;;
            *) return 0 ;;
        esac
    fi

    if [[ "$arg" == "off" || "$arg" == "0" || "$arg" == "all" || "$arg" == "none" || "$arg" == "reset" ]]; then
        DURATION_FILTER_EXPR=""
        DURATION_FILTER_LABEL=""
        echo -e "${C_GREEN}✔ ${MSG_DUR_CLEARED:-Filtro de duración desactivado.}${C_RESET}"
        return 0
    fi

    local op=">="
    local op_label=">="
    local raw_dur="$arg"
    if [[ "$arg" =~ ^(>=|>|\+)(.+)$ ]]; then
        op=">="
        op_label=">="
        raw_dur="${BASH_REMATCH[2]}"
    elif [[ "$arg" =~ ^(<=|<|-)(.+)$ ]]; then
        op="<="
        op_label="<="
        raw_dur="${BASH_REMATCH[2]}"
    fi

    local secs=""
    if secs=$(parse_duration_to_seconds "$raw_dur"); then
        DURATION_FILTER_EXPR="duration ${op} ${secs}"
        DURATION_FILTER_LABEL="${op_label} ${raw_dur}"
        echo -e "${C_GREEN}✔ ${MSG_DUR_SET:-Filtro de duración activo:} ${C_BOLD}${DURATION_FILTER_LABEL}${C_RESET}"
    else
        echo -e "${C_RED}[ERROR]${C_RESET} ${MSG_DUR_INVALID:-Formato inválido. Usa por ejemplo: :dur >5m, :dur >15m, :dur >1h, :dur <10m o :dur off.}"
    fi
}

# Resolución del directorio de idiomas (i18n)
LANG_DIR=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -d "${SCRIPT_DIR}/lang" ]; then
    LANG_DIR="${SCRIPT_DIR}/lang"
elif [ -d "${HOME}/.local/share/yt-cli/lang" ]; then
    LANG_DIR="${HOME}/.local/share/yt-cli/lang"
elif [ -d "/usr/share/yt-cli/lang" ]; then
    LANG_DIR="/usr/share/yt-cli/lang"
fi

detect_default_lang() {
    local sys_l="${LANG:-${LC_ALL:-en}}"
    local code="${sys_l%%_*}"
    code="${code%%.*}"
    code="${code,,}"
    if [ -n "$LANG_DIR" ] && [ -f "${LANG_DIR}/${code}.sh" ]; then
        echo "$code"
    else
        echo "en"
    fi
}

load_language() {
    local target_lang="${1:-es}"
    # 1. Fallback base: English
    if [ -n "$LANG_DIR" ] && [ -f "${LANG_DIR}/en.sh" ]; then
        # shellcheck source=/dev/null
        source "${LANG_DIR}/en.sh"
    fi
    # 2. Carga del idioma solicitado
    if [ -n "$LANG_DIR" ] && [ -f "${LANG_DIR}/${target_lang}.sh" ]; then
        # shellcheck source=/dev/null
        source "${LANG_DIR}/${target_lang}.sh"
    fi
}

set_language() {
    local new_lang="${1,,}"
    if [ -z "$new_lang" ] || [ ! -f "${LANG_DIR}/${new_lang}.sh" ]; then
        echo -e "${C_CYAN}${MSG_LANG_CHOOSE:-Select language / Selecciona idioma:}${C_RESET}"
        local -a codes=()
        local i=1
        local -a ordered_files=()
        [ -f "${LANG_DIR}/en.sh" ] && ordered_files+=("${LANG_DIR}/en.sh")
        [ -f "${LANG_DIR}/es.sh" ] && ordered_files+=("${LANG_DIR}/es.sh")
        for f in "${LANG_DIR}"/*.sh; do
            [ -f "$f" ] || continue
            local b_name
            b_name="$(basename "$f")"
            [[ "$b_name" == "en.sh" || "$b_name" == "es.sh" ]] && continue
            ordered_files+=("$f")
        done
        for f in "${ordered_files[@]}"; do
            local c_code
            c_code="$(basename "$f" .sh)"
            local c_name
            c_name="$(grep -E '^LANG_NAME=' "$f" 2>/dev/null | head -n1 | cut -d'=' -f2- | tr -d '"'\''')"
            [ -z "$c_name" ] && c_name="$c_code"
            codes+=("$c_code")
            printf "  [%2d] %-14s (%s)\n" "$i" "$c_name" "$c_code"
            i=$((i + 1))
        done
        local total=${#codes[@]}
        echo -ne "Opción / Choice [1-${total} o código]: "
        local c=""
        if [ -t 0 ]; then read -r c; else read -r c </dev/tty; fi
        if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 1 ] && [ "$c" -le "$total" ]; then
            new_lang="${codes[$((c - 1))]}"
        elif [ -n "$c" ] && [ -f "${LANG_DIR}/${c,,}.sh" ]; then
            new_lang="${c,,}"
        else
            new_lang="$CURRENT_LANG"
        fi
    fi

    load_language "$new_lang"
    CURRENT_LANG="$new_lang"

    # Persistir en ~/.config/yt-cli/config
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    if [ -f "$CONFIG_FILE" ]; then
        sed -i '/^CLI_LANG=/d' "$CONFIG_FILE" 2>/dev/null || true
    fi
    echo "CLI_LANG=\"${new_lang}\"" >> "$CONFIG_FILE"
    echo -e "${C_GREEN}${MSG_LANG_SAVED:-✔ Idioma configurado / Language set to:} ${C_BOLD}${LANG_NAME:-$new_lang}${C_RESET}"
}

# Inicializar idioma por defecto o guardado
CURRENT_LANG="$(detect_default_lang)"
if [ -f "$CONFIG_FILE" ]; then
    saved_lang=$(grep -E '^CLI_LANG=' "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d '"'\'' ' || true)
    [ -n "$saved_lang" ] && CURRENT_LANG="$saved_lang"
fi
load_language "$CURRENT_LANG"

# Guardar elemento en el historial
record_history() {
    local full_title="$1"
    local vid_id="$2"

    python3 - "$HISTORY_FILE" "$full_title" "$vid_id" << 'EOF' 2>/dev/null || true
import sys, json, os, time
path = os.path.expanduser(sys.argv[1])
full_title = sys.argv[2]
vid_id = sys.argv[3]
data = {'enabled': True, 'max_items': 50, 'history': []}
if os.path.isfile(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
    except Exception:
        pass
if data.get('enabled', True):
    hist = [x for x in data.get('history', []) if x.get('id') != vid_id]
    hist.insert(0, {
        'title': full_title,
        'channel': 'YouTube',
        'duration': '--:--',
        'id': vid_id,
        'date': time.strftime('%d/%m/%Y %H:%M')
    })
    data['history'] = hist[:data.get('max_items', 50)]
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
EOF
}

# Borrar un elemento específico del historial
delete_history_item() {
    local vid_id="$1"
    python3 - "$HISTORY_FILE" "$vid_id" << 'EOF' 2>/dev/null || true
import sys, json, os
path = os.path.expanduser(sys.argv[1])
vid_id = sys.argv[2]
if os.path.isfile(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        data['history'] = [x for x in data.get('history', []) if x.get('id') != vid_id]
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception:
        pass
EOF
    echo -e "${C_GREEN}${MSG_HIST_ITEM_DELETED:-✔ Elemento eliminado del historial.}${C_RESET}"
}

# Ver y seleccionar del historial
show_history_menu() {
    printf "\r\033[2K"
    while true; do
        if [ ! -f "$HISTORY_FILE" ]; then
            echo -e "${C_YELLOW}${MSG_HIST_EMPTY}${C_RESET}"
            sleep 1.5
            return
        fi

        local hist_list
        hist_list=$(python3 - "$HISTORY_FILE" << 'EOF' 2>/dev/null
import sys, json, os
path = os.path.expanduser(sys.argv[1])
if os.path.isfile(path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            d = json.load(f)
            for item in d.get('history', []):
                print(f"{item.get('title','')} [{item.get('date','')}]\t{item.get('id','')}")
    except Exception:
        pass
EOF
)

        if [ -z "$hist_list" ]; then
            echo -e "${C_YELLOW}${MSG_HIST_EMPTY}${C_RESET}"
            sleep 1.5
            return
        fi

        hist_list="${hist_list}"$'\n'"${MSG_HIST_CLEAR_OPTION}	__CLEAR_HISTORY__"

        local fzf_output
        fzf_output=$(echo "$hist_list" | "$BIN_FZF" \
            --delimiter='\t' \
            --with-nth=1 \
            --prompt="${MSG_HIST_PROMPT}" \
            --header="${MSG_HIST_HEADER}" \
            --expect=ctrl-d,del \
            --height=60% \
            --reverse \
            --border) || true

        [ -z "$fzf_output" ] && return

        local key
        local selection
        key=$(echo "$fzf_output" | sed -n '1p')
        selection=$(echo "$fzf_output" | sed -n '2p')

        [ -z "$selection" ] && return

        local id
        id=$(echo "$selection" | awk -F'\t' '{print $2}')
        [ -z "$id" ] && return

        if [ "$id" = "__CLEAR_HISTORY__" ]; then
            clear_history
            sleep 1.5
            return
        fi

        # Si el usuario pulsó Ctrl+D o Supr/Del directamente en FZF
        if [[ "$key" == "ctrl-d" || "$key" == "del" ]]; then
            delete_history_item "$id"
            sleep 0.8
            continue
        fi

        local clean_title
        clean_title=$(echo "$selection" | awk -F'\t' '{print $1}' | sed -E 's/ \[[0-9]{2}\/[0-9]{2}\/[0-9]{4} [0-9]{2}:[0-9]{2}\]$//')

        local url="$id"
        if [[ ! "$id" =~ ^https?:// ]]; then
            url="https://www.youtube.com/watch?v=${id}"
        fi

        choose_action "1" "history"
        case "$SELECTED_ACTION" in
            play_720)
                record_history "$clean_title" "$id"
                play_videos "720" "$url"
                return
                ;;
            play_1080)
                record_history "$clean_title" "$id"
                play_videos "1080" "$url"
                return
                ;;
            play_480)
                record_history "$clean_title" "$id"
                play_videos "480" "$url"
                return
                ;;
            play_audio)
                record_history "$clean_title" "$id"
                play_videos "audio" "$url"
                return
                ;;
            down_720)
                record_history "$clean_title" "$id"
                download_videos "720" "$url"
                return
                ;;
            down_1080)
                record_history "$clean_title" "$id"
                download_videos "1080" "$url"
                return
                ;;
            down_mp3)
                record_history "$clean_title" "$id"
                download_music "$url"
                return
                ;;
            down_chapters)
                record_history "$clean_title" "$id"
                download_chapters "$url"
                return
                ;;
            down_section)
                record_history "$clean_title" "$id"
                download_section "" "" "" "$url"
                return
                ;;
            down_transcript)
                record_history "$clean_title" "$id"
                download_transcript "$url"
                return
                ;;
            delete)
                delete_history_item "$id"
                sleep 0.8
                continue
                ;;
            back|cancel)
                continue
                ;;
        esac
    done
}

# Borrar historial
clear_history() {
    python3 - "$HISTORY_FILE" << 'EOF' 2>/dev/null || true
import sys, json, os
path = os.path.expanduser(sys.argv[1])
if os.path.isfile(path):
    with open(path, 'w', encoding='utf-8') as f:
        json.dump({'enabled': True, 'max_items': 50, 'history': []}, f, indent=2)
EOF
    echo -e "${C_GREEN}${MSG_HIST_CLEARED}${C_RESET}"
}

# Signal trap for clean exit
trap 'echo -e "\n${C_GRAY}Saliendo de YT-CLI... Hasta luego.${C_RESET}"; exit 0' SIGINT SIGTERM

# 1. Dependency validation with guided installation
check_dependencies() {
    local missing=()
    for dep in "$BIN_YTDLP" "$BIN_FZF" "$BIN_MPV"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            missing+=("$dep")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${C_RED}[ERROR]${C_RESET} Faltan dependencias necesarias: ${C_BOLD}${missing[*]}${C_RESET}"
        echo -e "${C_YELLOW}Comando para instalarlas en tu sistema:${C_RESET}"
        if command -v apt >/dev/null 2>&1; then
            echo -e "  ${C_BOLD}sudo apt update && sudo apt install ${missing[*]}${C_RESET}"
        elif command -v pacman >/dev/null 2>&1; then
            echo -e "  ${C_BOLD}sudo pacman -S ${missing[*]}${C_RESET}"
        elif command -v dnf >/dev/null 2>&1; then
            echo -e "  ${C_BOLD}sudo dnf install ${missing[*]}${C_RESET}"
        fi
        exit 1
    fi
}

# 2. Notificación de escritorio nativa (no bloqueante)
notify_user() {
    local title="$1"
    local message="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$message" -i video-television 2>/dev/null || true
    fi
}

# 3. Detección automática de enlaces en el portapapeles (Wayland y X11)
get_clipboard_url() {
    local clip=""
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
        clip=$(wl-paste 2>/dev/null || true)
    elif command -v xclip >/dev/null 2>&1; then
        clip=$(xclip -o -selection clipboard 2>/dev/null || true)
    elif command -v xsel >/dev/null 2>&1; then
        clip=$(xsel --clipboard --output 2>/dev/null || true)
    elif command -v wl-paste >/dev/null 2>&1; then
        clip=$(wl-paste 2>/dev/null || true)
    fi

    # Limpiar espacios
    clip=$(echo "$clip" | xargs 2>/dev/null || echo "$clip")

    if [[ "$clip" =~ ^https?://(www\.|vm\.|vt\.)?(youtube\.com|youtu\.be|tiktok\.com|twitter\.com|x\.com|instagram\.com|vimeo\.com|facebook\.com|reddit\.com|twitch\.tv|soundcloud\.com) ]]; then
        echo "$clip"
    fi
}

# 4. Selector de carpeta de destino interactivo
choose_destination_folder() {
    local type="$1" # "video", "audio" o "doc"
    local default_folder="$CURRENT_DIR_VIDEOS"
    [ "$type" = "audio" ] && default_folder="$CURRENT_DIR_MUSIC"
    [ "$type" = "doc" ] && default_folder="$CURRENT_DIR_DOCS"

    echo -e "${C_CYAN}${MSG_DL_DEST_TITLE}${C_RESET}" >&2
    echo -e "  ${C_BOLD}[1]${C_RESET} ${MSG_DL_DEST_DEFAULT} ${C_GREEN}${default_folder}${C_RESET} ${C_YELLOW}★${C_RESET}" >&2

    # Detectar si hay pendrives o discos externos montados en /media/$USER
    local media_dirs=()
    if [ -d "/media/${USER}" ]; then
        while IFS= read -r dir; do
            [ -d "$dir" ] && media_dirs+=("$dir")
        done < <(find "/media/${USER}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
    fi

    local opt_index=2
    if [ ${#media_dirs[@]} -gt 0 ]; then
        for mdir in "${media_dirs[@]}"; do
            echo -e "  ${C_BOLD}[${opt_index}]${C_RESET} ${MSG_DL_DEST_DRIVE} ${C_CYAN}${mdir}${C_RESET}" >&2
            opt_index=$((opt_index + 1))
        done
    fi

    echo -e "  ${C_BOLD}[c]${C_RESET} ${MSG_DL_DEST_CUSTOM}" >&2
    echo -e "  ${C_BOLD}[0]${C_RESET} ${MSG_ACTION_0:-Volver a la lista / Cancelar}" >&2
    echo "" >&2
    echo -ne "${C_YELLOW}${MSG_DL_DEST_PROMPT}${C_RESET}" >&2

    local choice=""
    if [ -t 0 ]; then read -r choice || choice="1"; else read -r choice </dev/tty || choice="1"; fi
    if [[ "$choice" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
        echo "CANCEL"
        return
    fi
    [ -z "$choice" ] && choice="1"
    echo "" >&2

    if [ "$choice" = "1" ]; then
        echo "$default_folder"
    elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 2 ] && [ "$choice" -lt "$opt_index" ]; then
        local m_idx=$((choice - 2))
        echo "${media_dirs[$m_idx]}"
    elif [[ "$choice" =~ ^[cC]$ ]]; then
        echo -ne "${C_CYAN}${MSG_DL_DEST_INPUT}${C_RESET}" >&2
        local custom_path=""
        if [ -t 0 ]; then read -r custom_path; else read -r custom_path </dev/tty; fi
        if [[ "$custom_path" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
            echo "CANCEL"
            return
        fi
        custom_path="${custom_path/#\~/$HOME}"
        mkdir -p "$custom_path" 2>/dev/null || true
        echo "$custom_path"
    else
        echo "$default_folder"
    fi
}

SELECTED_ACTION="play_720"

# 5. Menú interactivo unificado (Reproducir / Descargar / Volver)
choose_action() {
    local count="${1:-1}"
    local is_history="${2:-false}"
    local label_items="${MSG_ACTION_SINGLE}"
    [ "$count" -gt 1 ] && label_items="${count} ${MSG_ACTION_MULTI}"

    echo -e "${C_CYAN}${MSG_ACTION_TITLE} ${label_items}?${C_RESET}"
    echo -e "  ${C_BOLD}${MSG_ACTION_STREAM_HEADER}${C_RESET}"
    echo -e "  ${C_BOLD}[1]${C_RESET} ${MSG_ACTION_1}"
    echo -e "  ${C_BOLD}[2]${C_RESET} ${MSG_ACTION_2}"
    echo -e "  ${C_BOLD}[3]${C_RESET} ${MSG_ACTION_3}"
    echo -e "  ${C_BOLD}[4]${C_RESET} ${MSG_ACTION_4}"
    echo ""
    echo -e "  ${C_BOLD}${MSG_ACTION_DOWNLOAD_HEADER}${C_RESET}"
    echo -e "  ${C_BOLD}[5]${C_RESET} ${MSG_ACTION_5}"
    echo -e "  ${C_BOLD}[6]${C_RESET} ${MSG_ACTION_6}"
    echo -e "  ${C_BOLD}[7]${C_RESET} ${MSG_ACTION_7}"
    echo -e "  ${C_BOLD}[8]${C_RESET} ${MSG_ACTION_8:-Descargar por capítulos  (Separar álbum/podcast por pistas)}"
    echo -e "  ${C_BOLD}[9]${C_RESET} ${MSG_ACTION_9:-Descargar fragmento     (Recortar intervalo de tiempo)}"
    echo -e "  ${C_BOLD}[t]${C_RESET} ${MSG_ACTION_T:-Extraer transcripción   (Guardar texto/subtítulos sin video)}"
    echo ""
    echo -e "  ${C_BOLD}${MSG_ACTION_NAV_HEADER}${C_RESET}"
    if [ "$is_history" = "history" ]; then
        echo -e "  ${C_BOLD}[d]${C_RESET} ${MSG_ACTION_DELETE_ITEM:-Borrar este elemento del historial}"
    fi
    echo -e "  ${C_BOLD}[0]${C_RESET} ${MSG_ACTION_0}"
    echo ""
    if [ "$is_history" = "history" ]; then
        echo -ne "${C_YELLOW}${MSG_ACTION_HIST_PROMPT:-Elige opción [1-9 | t texto | d borrar | 0 volver] (Enter para 720p): }${C_RESET}"
    else
        echo -ne "${C_YELLOW}${MSG_ACTION_PROMPT:-Elige opción [1-9 | t texto | 0 volver] (Enter para ver en 720p): }${C_RESET}"
    fi

    local user_opt=""
    if [ -t 0 ]; then
        read -r user_opt || user_opt="1"
    else
        read -r user_opt </dev/tty || user_opt="1"
    fi
    [ -z "$user_opt" ] && user_opt="1"
    echo ""

    case "$user_opt" in
        1) SELECTED_ACTION="play_720" ;;
        2) SELECTED_ACTION="play_1080" ;;
        3) SELECTED_ACTION="play_480" ;;
        4|[aA]) SELECTED_ACTION="play_audio" ;;
        5) SELECTED_ACTION="down_720" ;;
        6) SELECTED_ACTION="down_1080" ;;
        7|[mM]) SELECTED_ACTION="down_mp3" ;;
        8|[sS]) SELECTED_ACTION="down_chapters" ;;
        9|[fF]) SELECTED_ACTION="down_section" ;;
        [tT]|sub|subs|texto|transcript) SELECTED_ACTION="down_transcript" ;;
        [dD]|del|borrar|eliminar)
            if [ "$is_history" = "history" ]; then
                SELECTED_ACTION="delete"
            else
                SELECTED_ACTION="play_720"
            fi
            ;;
        0|[vV]|[bB]|[qQ]|cancel|cancelar|volver|atras) SELECTED_ACTION="back" ;;
        *) SELECTED_ACTION="play_720" ;;
    esac
}

# 6. Reproducción optimizada en MPV (con soporte para colas múltiples)
play_videos() {
    local quality="$1"
    shift
    local targets=("$@")

    local MPV_ARGS=(
        "--script-opts=ytdl_hook-ytdl_path=${BIN_YTDLP}"
        "--msg-level=all=no,statusline=status"
        "--save-position-on-quit"
        "--watch-later-options=start"
        "--ytdl-raw-options-append=extractor-args=youtube:lang=${CURRENT_LANG}"
    )
    if [ ${#COOKIE_MPV_ARGS[@]} -gt 0 ]; then
        MPV_ARGS+=("${COOKIE_MPV_ARGS[@]}")
    fi

    if [ "$quality" = "audio" ]; then
        echo -e "${C_CYAN}${MSG_MPV_AUDIO_START}${C_RESET}"
        echo -e "${C_YELLOW}${MSG_MPV_AUDIO_WAIT}${C_RESET}"
        MPV_ARGS+=(
            "--title=YT-CLI - Audio Player"
            "--vid=no"
            "--force-window=yes"
            "--geometry=560x220"
            "--player-operation-mode=pseudo-gui"
            "--ytdl-format=bestaudio[ext=m4a]/bestaudio/best"
        )
    else
        local fps_filter=""
        case "${MAX_FPS,,}" in
            auto) fps_filter="" ;;
            60)   fps_filter="[fps<=60]" ;;
            30|*) fps_filter="[fps<=30]" ;;
        esac

        local target_h="720"
        case "$quality" in
            360)
                echo -e "${C_CYAN}${MSG_MPV_PLAY_360}${C_RESET}"
                target_h="360"
                ;;
            480)
                echo -e "${C_CYAN}${MSG_MPV_PLAY_480}${C_RESET}"
                target_h="480"
                ;;
            1080)
                if [ -z "${FPS_CLI_OVERRIDE:-}" ]; then
                    echo -ne "${C_YELLOW}${MSG_FPS_PROMPT:-FPS: [1] 30fps (Estándar) ★ | [2] 60fps (Enter para 30): }${C_RESET}"
                    local fps_opt=""
                    if [ -t 0 ]; then read -r fps_opt || fps_opt="1"; else read -r fps_opt </dev/tty || fps_opt="1"; fi
                    case "$fps_opt" in
                        2|60) fps_filter="[fps<=60]" ;;
                        *)    fps_filter="[fps<=30]" ;;
                    esac
                fi
                echo -e "${C_CYAN}${MSG_MPV_PLAY_1080}${C_RESET}"
                target_h="1080"
                ;;
            720|*)
                echo -e "${C_CYAN}${MSG_MPV_PLAY_720}${C_RESET}"
                target_h="720"
                ;;
        esac

        local ytdl_fmt="bestvideo[vcodec^=avc1][height<=${target_h}]${fps_filter}+bestaudio/bestvideo[height<=${target_h}]${fps_filter}+bestaudio/bestvideo[height<=${target_h}]+bestaudio/best[height<=${target_h}]${fps_filter}/best[height<=${target_h}]/best"

        MPV_ARGS+=(
            "--hwdec=auto-safe"
            "--vo=gpu"
            "--ytdl-format=${ytdl_fmt}"
        )
        if [ "$SPONSORBLOCK_MARK" = "true" ]; then
            MPV_ARGS+=("--ytdl-raw-options-append=sponsorblock-mark=${SPONSORBLOCK_CATS}")
        fi
    fi

    # Formatear URLs con prefijo ytdl://
    local formatted_urls=()
    for t in "${targets[@]}"; do
        if [[ "$t" =~ ^https?:// ]]; then
            formatted_urls+=("ytdl://${t}")
        else
            formatted_urls+=("$t")
        fi
    done

    if [ "$quality" = "audio" ]; then
        echo -e "${C_GRAY}${MSG_MPV_AUDIO_TIPS}${C_RESET}\n"
    elif [ ${#formatted_urls[@]} -gt 1 ]; then
        echo -e "${C_GREEN}${MSG_MPV_QUEUE_ACTIVE} ${#formatted_urls[@]} ${MSG_ACTION_MULTI}.${C_RESET}"
        echo -e "${C_GRAY}${MSG_MPV_QUEUE_TIPS}${C_RESET}\n"
    else
        echo -e "${C_GRAY}${MSG_MPV_SINGLE_TIPS}${C_RESET}\n"
    fi

    "$BIN_MPV" "${MPV_ARGS[@]}" "${formatted_urls[@]}" || true
    echo ""
}

# 7. Descarga optimizada de video (MP4 / H.264 / Reanudación)
download_videos() {
    local height="$1"
    shift
    local targets=("$@")

    local dest_dir
    dest_dir=$(choose_destination_folder "video")
    if [ -z "$dest_dir" ] || [ "$dest_dir" = "CANCEL" ]; then
        return
    fi
    mkdir -p "$dest_dir" 2>/dev/null || true

    echo -e "${C_CYAN}${MSG_DL_VIDEO_START} ${height}p (H.264 / continue)...${C_RESET}"
    echo -e "${C_GRAY}${MSG_DL_SAVING_IN} ${dest_dir}/${C_RESET}\n"

    local ytdl_fmt="bestvideo[vcodec^=avc1][height<=${height}][fps<=30]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc1][height<=${height}]+bestaudio[ext=m4a]/bestvideo[height<=${height}]+bestaudio[ext=m4a]/bestvideo[height<=${height}]+bestaudio/best[height<=${height}]/best"

    local has_error=0
    for t in "${targets[@]}"; do
        if ! "$BIN_YTDLP" \
            ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
            ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
            -c \
            --download-archive "${ARCHIVE_FILE}" \
            -f "${ytdl_fmt}" \
            --merge-output-format mp4 \
            --embed-thumbnail \
            --embed-metadata \
            --no-warnings \
            -o "${dest_dir}/%(title)s.%(ext)s" \
            "$t"; then
            has_error=1
        fi
    done

    if [ "$has_error" -eq 0 ]; then
        echo -e "\n${C_GREEN}${MSG_DL_ALL_COMPLETE}${C_RESET}"
        notify_user "${MSG_DL_SUCCESS_NOTIFY}" "${MSG_DL_SUCCESS_MSG} ${dest_dir}"
    else
        echo -e "\n${C_RED}✖ ${MSG_DL_FAILED}${C_RESET}"
    fi

    echo -ne "${C_YELLOW}${MSG_HELP_PRESS_ENTER}${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 8. Descarga optimizada de audio (MP3 / M4A / Opus / FLAC / Reanudación)
download_music() {
    local targets=("$@")

    echo -e "${C_CYAN}${MSG_DL_AUDIO_FORMAT_HEADER:-Selecciona formato de audio:}${C_RESET}"
    echo -e "  ${C_BOLD}[1]${C_RESET} ${MSG_DL_AUDIO_F1:-MP3 (Compatibilidad universal USB/reproductores) ★ Predeterminado}"
    echo -e "  ${C_BOLD}[2]${C_RESET} ${MSG_DL_AUDIO_F2:-M4A / AAC (Nativo de YT • Con carátula oficial • Copia rápida)}"
    echo -e "  ${C_BOLD}[3]${C_RESET} ${MSG_DL_AUDIO_F3:-Opus (Nativo de YT • Máxima fidelidad acústica • Ligero)}"
    echo -e "  ${C_BOLD}[4]${C_RESET} ${MSG_DL_AUDIO_F4:-FLAC (Audio sin pérdida / Lossless)}"
    echo -e "  ${C_BOLD}[0]${C_RESET} ${MSG_ACTION_0:-Volver a la lista / Cancelar}"
    echo ""
    echo -ne "${C_YELLOW}${MSG_DL_AUDIO_FORMAT_PROMPT:-Elige formato [1-4 | 0 para volver] (Enter para MP3): }${C_RESET}"

    local format_opt=""
    if [ -t 0 ]; then read -r format_opt || format_opt="1"; else read -r format_opt </dev/tty || format_opt="1"; fi
    if [[ "$format_opt" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
        return
    fi
    [ -z "$format_opt" ] && format_opt="1"
    echo ""

    local audio_fmt="mp3"
    local bitrate="320"
    case "$format_opt" in
        2) audio_fmt="m4a" ;;
        3) audio_fmt="opus" ;;
        4) audio_fmt="flac" ;;
        *) audio_fmt="mp3" ;;
    esac

    if [ "$audio_fmt" = "mp3" ]; then
        echo -e "${C_CYAN}${MSG_DL_MUSIC_QUALITY_HEADER}${C_RESET}"
        echo -e "  ${C_BOLD}[1]${C_RESET} ${MSG_DL_MUSIC_Q1}"
        echo -e "  ${C_BOLD}[2]${C_RESET} ${MSG_DL_MUSIC_Q2}"
        echo -e "  ${C_BOLD}[3]${C_RESET} ${MSG_DL_MUSIC_Q3}"
        echo -e "  ${C_BOLD}[0]${C_RESET} ${MSG_ACTION_0:-Volver a la lista / Cancelar}"
        echo ""
        echo -ne "${C_YELLOW}${MSG_DL_MUSIC_Q_PROMPT:-Elige calidad [1-3 | 0 para volver] (Enter para 320k): }${C_RESET}"

        local user_opt=""
        if [ -t 0 ]; then read -r user_opt || user_opt="1"; else read -r user_opt </dev/tty || user_opt="1"; fi
        if [[ "$user_opt" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
            return
        fi
        [ -z "$user_opt" ] && user_opt="1"
        echo ""

        case "$user_opt" in
            2) bitrate="192" ;;
            3) bitrate="128" ;;
            *) bitrate="320" ;;
        esac
    fi

    echo -ne "${C_CYAN}${MSG_DL_EMBED_COVER_PROMPT:-¿Incrustar carátula oficial? [S/n | 0 para volver]: }${C_RESET}"
    local user_cover=""
    if [ -t 0 ]; then read -r user_cover || user_cover="s"; else read -r user_cover </dev/tty || user_cover="s"; fi
    if [[ "$user_cover" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
        return
    fi
    [ -z "$user_cover" ] && user_cover="s"
    echo ""

    local EXTRA_ARGS=()
    if [[ ! "$user_cover" =~ ^[nN]$ ]]; then
        EXTRA_ARGS+=("--embed-thumbnail")
    fi

    local AUDIO_YTDL_FLAGS=("--extract-audio" "--audio-format" "$audio_fmt")
    if [ "$audio_fmt" = "mp3" ]; then
        AUDIO_YTDL_FLAGS+=("--audio-quality" "${bitrate}k")
    fi

    local dest_dir
    dest_dir=$(choose_destination_folder "audio")
    if [ -z "$dest_dir" ] || [ "$dest_dir" = "CANCEL" ]; then
        return
    fi
    mkdir -p "$dest_dir" 2>/dev/null || true

    local info_label="${audio_fmt^^}"
    [ "$audio_fmt" = "mp3" ] && info_label="MP3 (${bitrate} kbps)"
    echo -e "${C_CYAN}${MSG_DL_MUSIC_START:-🎵 Descargando audio en} ${info_label}...${C_RESET}"
    echo -e "${C_GRAY}${MSG_DL_SAVING_IN} ${dest_dir}/${C_RESET}\n"

    local has_error=0
    for t in "${targets[@]}"; do
        if ! "$BIN_YTDLP" \
            ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
            ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
            -c \
            --download-archive "${ARCHIVE_FILE}" \
            "${AUDIO_YTDL_FLAGS[@]}" \
            "${EXTRA_ARGS[@]}" \
            --embed-metadata \
            --no-warnings \
            -o "${dest_dir}/%(playlist_title&{}/|)s%(title)s.%(ext)s" \
            "$t"; then
            has_error=1
        fi
    done

    if [ "$has_error" -eq 0 ]; then
        echo -e "\n${C_GREEN}${MSG_DL_ALL_COMPLETE}${C_RESET}"
        notify_user "${MSG_DL_MUSIC_NOTIFY_TITLE}" "${MSG_DL_MUSIC_NOTIFY_MSG} ${dest_dir}"
    else
        echo -e "\n${C_RED}✖ ${MSG_DL_FAILED}${C_RESET}"
    fi

    echo -ne "${C_YELLOW}${MSG_HELP_PRESS_ENTER}${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 8b. Descarga optimizada dividida por capítulos (Álbumes / Podcasts / Cursos)
download_chapters() {
    local targets=("$@")

    echo -e "${C_CYAN}${MSG_DL_CHAPTERS_FORMAT_HEADER:-Selecciona formato para dividir por capítulos:}${C_RESET}"
    echo -e "  ${C_BOLD}[1]${C_RESET} ${MSG_DL_CHAPTERS_F1:-Audio MP3 (320k con carátula) ★ Predeterminado}"
    echo -e "  ${C_BOLD}[2]${C_RESET} ${MSG_DL_CHAPTERS_F2:-Audio M4A (Nativo de YT • Copia directa rápida)}"
    echo -e "  ${C_BOLD}[3]${C_RESET} ${MSG_DL_CHAPTERS_F3:-Video 720p HD (Archivos MP4 por capítulo)}"
    echo -e "  ${C_BOLD}[4]${C_RESET} ${MSG_DL_CHAPTERS_F4:-Video 1080p Full HD (Archivos MP4 por capítulo)}"
    echo -e "  ${C_BOLD}[0]${C_RESET} ${MSG_ACTION_0:-Volver a la lista / Cancelar}"
    echo ""
    echo -ne "${C_YELLOW}${MSG_DL_CHAPTERS_PROMPT:-Elige formato [1-4 | 0 para volver] (Enter para MP3): }${C_RESET}"

    local user_opt=""
    if [ -t 0 ]; then read -r user_opt || user_opt="1"; else read -r user_opt </dev/tty || user_opt="1"; fi
    if [[ "$user_opt" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
        return
    fi
    [ -z "$user_opt" ] && user_opt="1"
    echo ""

    local format_type="mp3"
    case "$user_opt" in
        2) format_type="m4a" ;;
        3) format_type="720" ;;
        4) format_type="1080" ;;
        *) format_type="mp3" ;;
    esac

    local dest_dir
    if [ "$format_type" = "mp3" ] || [ "$format_type" = "m4a" ]; then
        dest_dir=$(choose_destination_folder "audio")
    else
        dest_dir=$(choose_destination_folder "video")
    fi
    if [ -z "$dest_dir" ] || [ "$dest_dir" = "CANCEL" ]; then
        return
    fi
    mkdir -p "$dest_dir" 2>/dev/null || true

    echo -e "${C_CYAN}${MSG_DL_CHAPTERS_START:-✂ Descargando y dividiendo por capítulos...}${C_RESET}"
    echo -e "${C_GRAY}${MSG_DL_SAVING_IN} ${dest_dir}/${C_RESET}\n"

    local has_error=0
    for t in "${targets[@]}"; do
        if [ "$format_type" = "mp3" ]; then
            if ! "$BIN_YTDLP" \
                ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
                ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
                -c \
                --download-archive "${ARCHIVE_FILE}" \
                --split-chapters \
                --extract-audio \
                --audio-format mp3 \
                --audio-quality 320k \
                --embed-thumbnail \
                --embed-metadata \
                --no-warnings \
                -o "chapter:${dest_dir}/%(title)s/%(section_number)02d - %(section_title)s.%(ext)s" \
                -o "${dest_dir}/%(title)s.%(ext)s" \
                "$t"; then
                has_error=1
            fi
        elif [ "$format_type" = "m4a" ]; then
            if ! "$BIN_YTDLP" \
                ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
                ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
                -c \
                --download-archive "${ARCHIVE_FILE}" \
                --split-chapters \
                --extract-audio \
                --audio-format m4a \
                --embed-thumbnail \
                --embed-metadata \
                --no-warnings \
                -o "chapter:${dest_dir}/%(title)s/%(section_number)02d - %(section_title)s.%(ext)s" \
                -o "${dest_dir}/%(title)s.%(ext)s" \
                "$t"; then
                has_error=1
            fi
        else
            local height="$format_type"
            local ytdl_fmt="bestvideo[vcodec^=avc1][height<=${height}][fps<=30]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc1][height<=${height}]+bestaudio[ext=m4a]/bestvideo[height<=${height}]+bestaudio[ext=m4a]/bestvideo[height<=${height}]+bestaudio/best[height<=${height}]/best"
            if ! "$BIN_YTDLP" \
                ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
                ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
                -c \
                --download-archive "${ARCHIVE_FILE}" \
                --split-chapters \
                -f "${ytdl_fmt}" \
                --merge-output-format mp4 \
                --embed-thumbnail \
                --embed-metadata \
                --no-warnings \
                -o "chapter:${dest_dir}/%(title)s/%(section_number)02d - %(section_title)s.%(ext)s" \
                -o "${dest_dir}/%(title)s.%(ext)s" \
                "$t"; then
                has_error=1
            fi
        fi
    done

    if [ "$has_error" -eq 0 ]; then
        echo -e "\n${C_GREEN}${MSG_DL_ALL_COMPLETE}${C_RESET}"
        notify_user "${MSG_DL_SUCCESS_NOTIFY}" "${MSG_DL_SUCCESS_MSG} ${dest_dir}"
    else
        echo -e "\n${C_RED}✖ ${MSG_DL_FAILED}${C_RESET}"
    fi

    echo -ne "${C_YELLOW}${MSG_HELP_PRESS_ENTER}${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 8c. Descarga de fragmentos por rango de tiempo (--download-sections)
download_section() {
    local start_time="$1"
    local end_time="$2"
    local format_choice="$3"
    shift 3 2>/dev/null || true
    local targets=("$@")

    if [ -z "$start_time" ]; then
        echo -e "${C_CYAN}${MSG_SECTION_PROMPT_TITLE:-✂ Recorte de Fragmento de Video/Audio}${C_RESET}"
        echo -ne "${C_YELLOW}${MSG_SECTION_START_PROMPT:-Tiempo de inicio (ej: 00:02:30 o 2:30) [Enter para 00:00:00 | 0 para volver]: }${C_RESET}"
        if [ -t 0 ]; then read -r start_time; else read -r start_time </dev/tty; fi
        if [[ "$start_time" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
            return
        fi
        [ -z "$start_time" ] && start_time="00:00:00"

        echo -ne "${C_YELLOW}${MSG_SECTION_END_PROMPT:-Tiempo de fin (ej: 00:05:45 o 5:45) [0 para volver]: }${C_RESET}"
        if [ -t 0 ]; then read -r end_time; else read -r end_time </dev/tty; fi
        if [[ "$end_time" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
            return
        fi
        if [ -z "$end_time" ]; then
            echo -e "${C_RED}[ERROR]${C_RESET} Debes indicar un tiempo de finalización."
            return
        fi

        echo -e "\n${C_CYAN}${MSG_SECTION_FORMAT_TITLE:-Formato para el fragmento:}${C_RESET}"
        echo -e "  ${C_BOLD}[1]${C_RESET} Video 720p HD (MP4)"
        echo -e "  ${C_BOLD}[2]${C_RESET} Video 1080p Full HD (MP4)"
        echo -e "  ${C_BOLD}[3]${C_RESET} Audio MP3 (320k)"
        echo -e "  ${C_BOLD}[4]${C_RESET} Audio M4A (Nativo de YT)"
        echo -e "  ${C_BOLD}[0]${C_RESET} ${MSG_ACTION_0:-Volver a la lista / Cancelar}"
        echo ""
        echo -ne "${C_YELLOW}${MSG_DL_DEST_PROMPT:-Elige opción [1-4 | 0 para volver] (Enter para 720p): }${C_RESET}"
        if [ -t 0 ]; then read -r format_choice; else read -r format_choice </dev/tty; fi
        if [[ "$format_choice" =~ ^(0|[qQ]|cancel|cancelar|volver|atras)$ ]]; then
            return
        fi
        [ -z "$format_choice" ] && format_choice="1"
    fi

    local section_spec="*${start_time}-${end_time}"
    local dest_dir
    if [ "$format_choice" = "3" ] || [ "$format_choice" = "4" ] || [ "$format_choice" = "mp3" ] || [ "$format_choice" = "m4a" ]; then
        dest_dir=$(choose_destination_folder "audio")
    else
        dest_dir=$(choose_destination_folder "video")
    fi
    if [ -z "$dest_dir" ] || [ "$dest_dir" = "CANCEL" ]; then
        return
    fi
    mkdir -p "$dest_dir" 2>/dev/null || true

    echo -e "${C_CYAN}${MSG_SECTION_STARTING:-✂ Descargando fragmento} [${start_time} ➔ ${end_time}]...${C_RESET}"
    echo -e "${C_GRAY}${MSG_DL_SAVING_IN} ${dest_dir}/${C_RESET}\n"

    local clean_s="${start_time//:/-}"
    local clean_e="${end_time//:/-}"
    local has_error=0

    for t in "${targets[@]}"; do
        case "$format_choice" in
            3|mp3)
                if ! "$BIN_YTDLP" \
                    ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
                    ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
                    -c \
                    --download-sections "$section_spec" \
                    --extract-audio \
                    --audio-format mp3 \
                    --audio-quality 320k \
                    --embed-thumbnail \
                    --embed-metadata \
                    --force-keyframes-at-cuts \
                    -o "${dest_dir}/%(title)s [${clean_s}_${clean_e}].%(ext)s" \
                    "$t"; then
                    has_error=1
                fi
                ;;
            4|m4a)
                if ! "$BIN_YTDLP" \
                    ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
                    ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
                    -c \
                    --download-sections "$section_spec" \
                    --extract-audio \
                    --audio-format m4a \
                    --embed-thumbnail \
                    --embed-metadata \
                    --force-keyframes-at-cuts \
                    -o "${dest_dir}/%(title)s [${clean_s}_${clean_e}].%(ext)s" \
                    "$t"; then
                    has_error=1
                fi
                ;;
            2|1080)
                local ytdl_fmt="bestvideo[vcodec^=avc1][height<=1080][fps<=30]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc1][height<=1080]+bestaudio[ext=m4a]/bestvideo[height<=1080]+bestaudio[ext=m4a]/bestvideo[height<=1080]+bestaudio/best[height<=1080]/best"
                if ! "$BIN_YTDLP" \
                    ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
                    ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
                    -c \
                    --download-sections "$section_spec" \
                    -f "${ytdl_fmt}" \
                    --merge-output-format mp4 \
                    --embed-thumbnail \
                    --embed-metadata \
                    --force-keyframes-at-cuts \
                    -o "${dest_dir}/%(title)s [${clean_s}_${clean_e}].%(ext)s" \
                    "$t"; then
                    has_error=1
                fi
                ;;
            *)
                local ytdl_fmt="bestvideo[vcodec^=avc1][height<=720][fps<=30]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc1][height<=720]+bestaudio[ext=m4a]/bestvideo[height<=720]+bestaudio[ext=m4a]/bestvideo[height<=720]+bestaudio/best[height<=720]/best"
                if ! "$BIN_YTDLP" \
                    ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
                    ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
                    -c \
                    --download-sections "$section_spec" \
                    -f "${ytdl_fmt}" \
                    --merge-output-format mp4 \
                    --embed-thumbnail \
                    --embed-metadata \
                    --force-keyframes-at-cuts \
                    -o "${dest_dir}/%(title)s [${clean_s}_${clean_e}].%(ext)s" \
                    "$t"; then
                    has_error=1
                fi
                ;;
        esac
    done

    if [ "$has_error" -eq 0 ]; then
        echo -e "\n${C_GREEN}${MSG_DL_ALL_COMPLETE}${C_RESET}"
        notify_user "${MSG_DL_SUCCESS_NOTIFY}" "${MSG_DL_SUCCESS_MSG} ${dest_dir}"
    else
        echo -e "\n${C_RED}✖ ${MSG_DL_FAILED}${C_RESET}"
    fi

    echo -ne "${C_YELLOW}${MSG_HELP_PRESS_ENTER}${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 8d. Extracción limpia de subtítulos y transcripciones de texto (--write-auto-subs --skip-download)
download_transcript() {
    local targets=("$@")

    local dest_dir
    dest_dir=$(choose_destination_folder "doc")
    if [ -z "$dest_dir" ] || [ "$dest_dir" = "CANCEL" ]; then
        return
    fi
    mkdir -p "$dest_dir" 2>/dev/null || true

    echo -e "${C_CYAN}${MSG_TRANSCRIPT_START:-📝 Extrayendo transcripción y subtítulos en texto...}${C_RESET}"
    echo -e "${C_GRAY}${MSG_DL_SAVING_IN} ${dest_dir}/${C_RESET}\n"

    local has_error=0
    for t in "${targets[@]}"; do
        if ! "$BIN_YTDLP" \
            ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
            ${EXTRA_YTDL_ARGS[@]+"${EXTRA_YTDL_ARGS[@]}"} \
            --skip-download \
            --write-subs \
            --write-auto-subs \
            --sub-lang "${CURRENT_LANG},es,en" \
            --sub-format "srt/vtt/best" \
            --convert-subs srt \
            --no-warnings \
            -o "${dest_dir}/%(title)s.%(ext)s" \
            "$t"; then
            has_error=1
        else
            python3 - "$dest_dir" << 'EOF' 2>/dev/null || true
import sys, os, glob, re

target_dir = sys.argv[1]
srt_files = glob.glob(os.path.join(target_dir, "*.srt"))

for srt_path in srt_files:
    txt_path = os.path.splitext(srt_path)[0] + ".txt"
    if os.path.exists(txt_path):
        continue
    try:
        with open(srt_path, "r", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
        clean_text = []
        last_line = ""
        for line in lines:
            line = line.strip()
            if not line or line.isdigit() or "-->" in line:
                continue
            line = re.sub(r"<[^>]+>", "", line).strip()
            if line and line != last_line:
                clean_text.append(line)
                last_line = line
        if clean_text:
            with open(txt_path, "w", encoding="utf-8") as out:
                out.write("\n".join(clean_text) + "\n")
    except Exception:
        pass
EOF
        fi
    done

    if [ "$has_error" -eq 0 ]; then
        echo -e "\n${C_GREEN}${MSG_TRANSCRIPT_SUCCESS:-✔ Transcripción guardada (.srt y .txt limpio).}${C_RESET}"
        notify_user "Transcripción Guardada" "Texto guardado en ${dest_dir}"
    else
        echo -e "\n${C_RED}✖ ${MSG_DL_FAILED}${C_RESET}"
    fi

    echo -ne "${C_YELLOW}${MSG_HELP_PRESS_ENTER}${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 8e. Actualización de yt-dlp
update_ytdlp() {
    echo -e "${C_CYAN}${MSG_UPDATE_START:-🔄 Comprobando actualizaciones de yt-dlp...}${C_RESET}\n"

    if "$BIN_YTDLP" -U; then
        echo -e "\n${C_GREEN}${MSG_UPDATE_SUCCESS:-✔ yt-dlp actualizado correctamente a la última versión oficial.}${C_RESET}"
    else
        echo -e "\n${C_YELLOW}${MSG_UPDATE_FAIL:-No se pudo actualizar automáticamente con yt-dlp -U.}${C_RESET}"
        echo -e "${C_GRAY}${MSG_UPDATE_TIP:-Sugerencia: Si instalaste mediante pipx ejecuta 'pipx upgrade yt-dlp', o actualiza mediante tu gestor de paquetes.}${C_RESET}"
    fi

    echo -ne "\n${C_YELLOW}${MSG_HELP_PRESS_ENTER:-Presiona [Enter] para continuar...}${C_RESET}"
    local _dummy=""
    if [ -t 0 ]; then read -r _dummy; else read -r _dummy </dev/tty; fi
}

# 9. Flujo interactivo de búsqueda y cola con FZF (Multi-select)
search_and_play() {
    local query="$1"
    local forced_mode="${2:-ask}"

    local search_args=()
    if [[ "$query" =~ ^@([a-zA-Z0-9_.-]+)[[:space:]]+(.+)$ ]]; then
        local ch="${BASH_REMATCH[1]}"
        local term="${BASH_REMATCH[2]}"
        echo -ne "${C_YELLOW}${MSG_SEARCHING_CHANNEL:-Buscando en canal} @${ch}:${C_RESET} \"${C_BOLD}${term}${C_RESET}\" (${SEARCH_LIMIT})... \r"
        search_args=("https://www.youtube.com/@${ch}/search?query=${term}" "--playlist-end" "$SEARCH_LIMIT")
    elif [[ "$query" =~ ^@([a-zA-Z0-9_.-]+)$ ]]; then
        local ch="${BASH_REMATCH[1]}"
        echo -ne "${C_YELLOW}${MSG_FETCHING_CHANNEL:-Obteniendo videos del canal} @${ch}${C_RESET} (${SEARCH_LIMIT})... \r"
        search_args=("https://www.youtube.com/@${ch}/videos" "--playlist-end" "$SEARCH_LIMIT")
    else
        echo -ne "${C_YELLOW}${MSG_SEARCHING:-Buscando en YouTube:} \"${C_BOLD}${query}${C_RESET}\" (${SEARCH_LIMIT})... \r"
        search_args=("ytsearch${SEARCH_LIMIT}:${query}")
    fi

    local dur_args=()
    if [ -n "$DURATION_FILTER_EXPR" ]; then
        dur_args=("--match-filter" "$DURATION_FILTER_EXPR")
    fi

    local search_results
    search_results=$("$BIN_YTDLP" \
        ${COOKIE_YTDL_ARGS[@]+"${COOKIE_YTDL_ARGS[@]}"} \
        ${FILTER_ARGS[@]+"${FILTER_ARGS[@]}"} \
        ${dur_args[@]+"${dur_args[@]}"} \
        "${search_args[@]}" \
        --flat-playlist \
        --skip-download \
        --no-warnings \
        --extractor-args "youtube:lang=${CURRENT_LANG}" \
        --print "%(title)s [%(duration_string)s - %(uploader)s]	%(id)s" 2>/dev/null) || true

    if [ -z "$search_results" ]; then
        echo -e "${C_RED}${MSG_NO_RESULTS:-No se encontraron resultados para:}${C_RESET} \"$query\""
        if [ -n "$DURATION_FILTER_LABEL" ]; then
            echo -e "${C_GRAY}${MSG_NO_RESULTS_FILTER_HINT:-Filtro activo:}${C_RESET} ${C_CYAN}${DURATION_FILTER_LABEL}${C_RESET} (${MSG_LIMIT_LABEL:-Resultados:} ${SEARCH_LIMIT}). ${C_GRAY}${MSG_NO_RESULTS_TRY_LIMIT:-Prueba subir :limit 100 o quitar con :dur off.}${C_RESET}"
        fi
        return
    fi

    while true; do
        echo -ne "\033[2K\r"

        local raw_selection
        raw_selection=$(echo "$search_results" | "$BIN_FZF" \
            --delimiter='\t' \
            --with-nth=1 \
            --multi \
            --prompt="${MSG_FZF_PROMPT:-▶ Selecciona video(s) > }" \
            --header="${MSG_FZF_HEADER:-[Enter] Ver | [Tab] Marcar varios | [ESC] Salir | [Flechas] Navegar}" \
            --height=70% \
            --reverse \
            --border \
            --info=inline) || true

        if [ -z "$raw_selection" ]; then
            echo -e "${C_GRAY}${MSG_EXITING_LIST:-Saliendo de la lista actual de resultados...}${C_RESET}"
            break
        fi

        # Extraer URLs de los elementos seleccionados
        local selected_urls=()
        local selected_count=0
        while IFS=$'\t' read -r title id; do
            if [ -n "$id" ]; then
                selected_urls+=("https://www.youtube.com/watch?v=${id}")
                record_history "$title" "$id"
                selected_count=$((selected_count + 1))
            fi
        done <<< "$raw_selection"

        echo -e "\n${C_GREEN}✔ ${MSG_SELECTED_ITEMS:-Elementos seleccionados:}${C_RESET} ${C_BOLD}${selected_count}${C_RESET}\n"

        if [ "$forced_mode" = "ask" ]; then
            choose_action "$selected_count"
            case "$SELECTED_ACTION" in
                play_720)   play_videos "720" "${selected_urls[@]}" ;;
                play_1080)  play_videos "1080" "${selected_urls[@]}" ;;
                play_480)   play_videos "480" "${selected_urls[@]}" ;;
                play_audio) play_videos "audio" "${selected_urls[@]}" ;;
                down_720)        download_videos "720" "${selected_urls[@]}" ;;
                down_1080)       download_videos "1080" "${selected_urls[@]}" ;;
                down_mp3)        download_music "${selected_urls[@]}" ;;
                down_chapters)   download_chapters "${selected_urls[@]}" ;;
                down_section)    download_section "" "" "" "${selected_urls[@]}" ;;
                down_transcript) download_transcript "${selected_urls[@]}" ;;
                back|cancel)     continue ;;
            esac
        else
            if [ "$forced_mode" = "down_chapters" ]; then
                download_chapters "${selected_urls[@]}"
            elif [ "$forced_mode" = "down_section" ]; then
                download_section "" "" "" "${selected_urls[@]}"
            elif [ "$forced_mode" = "down_transcript" ]; then
                download_transcript "${selected_urls[@]}"
            else
                play_videos "$forced_mode" "${selected_urls[@]}"
            fi
        fi
    done
}

# Guardar enlace directo/playlist en historial y mostrar menú de acciones
handle_direct_url() {
    local target_url="$1"
    local label="URL: ${target_url}"
    if [[ "$target_url" == *"list="* ]]; then
        label="Playlist: ${target_url}"
    fi
    record_history "$label" "$target_url"

    choose_action "1"
    case "$SELECTED_ACTION" in
        play_720)        play_videos "720" "$target_url" ;;
        play_1080)       play_videos "1080" "$target_url" ;;
        play_480)        play_videos "480" "$target_url" ;;
        play_audio)      play_videos "audio" "$target_url" ;;
        down_720)        download_videos "720" "$target_url" ;;
        down_1080)       download_videos "1080" "$target_url" ;;
        down_mp3)        download_music "$target_url" ;;
        down_chapters)   download_chapters "$target_url" ;;
        down_section)    download_section "" "" "" "$target_url" ;;
        down_transcript) download_transcript "$target_url" ;;
        back|cancel)     return ;;
    esac
}

