# 10b. Ayuda interactiva rápida
show_interactive_help() {
    clear
    echo -e "${C_CYAN}================================================================${C_RESET}"
    echo -e "${C_BOLD}                   ${MSG_HELP_TITLE:-GUÍA RÁPIDA DE COMANDOS (YT-CLI)}${C_RESET}"
    echo -e "${C_CYAN}================================================================${C_RESET}\n"
    echo -e "  ${C_YELLOW}${MSG_HELP_SEARCH_HEADER:-Búsquedas y Enlaces:}${C_RESET}"
    echo -e "    ${C_GREEN}palabras clave / keywords${C_RESET} ${MSG_HELP_SEARCH_KW}"
    echo -e "    ${C_GREEN}@canal / @channel${C_RESET}         ${MSG_HELP_SEARCH_CH}"
    echo -e "    ${C_GREEN}@canal query${C_RESET}              ${MSG_HELP_SEARCH_CH_TERM}"
    echo -e "    ${C_GREEN}https://...${C_RESET}                   ${MSG_HELP_SEARCH_URL}\n"
    echo -e "  ${C_YELLOW}${MSG_HELP_CMD_HEADER:-Comandos en la consola interactiva:}${C_RESET}"
    echo -e "    ${C_GREEN}:help${C_RESET} o ${C_GREEN}:?${C_RESET}                   ${MSG_HELP_CMD_HELP}"
    echo -e "    ${C_GREEN}:h${C_RESET}                            ${MSG_HELP_CMD_HIST}"
    echo -e "    ${C_GREEN}:clear${C_RESET}                        ${MSG_HELP_CMD_CLEAR}"
    echo -e "    ${C_GREEN}:u${C_RESET} o ${C_GREEN}:update${C_RESET}                 ${MSG_HELP_CMD_UPDATE:-Actualiza yt-dlp a la última versión oficial}"
    echo -e "    ${C_GREEN}:clear-archive${C_RESET} o ${C_GREEN}:ca${C_RESET}           ${MSG_HELP_CMD_ARCHIVE:-Reinicia el registro de descargas previas}"
    echo -e "    ${C_GREEN}:c${C_RESET}                            ${MSG_HELP_CMD_COOKIE}"
    echo -e "    ${C_GREEN}:limit [1-200]${C_RESET}                ${MSG_HELP_CMD_LIMIT:-Ajustar cantidad de resultados (ej: :limit 50, :limit 100)}"
    echo -e "    ${C_GREEN}:dur [>5m|>1h|off]${C_RESET}            ${MSG_HELP_CMD_DUR:-Filtrar por duración mínima o máxima (ej: :dur >15m)}"
    echo -e "    ${C_GREEN}:lang [es|en]${C_RESET}                 ${MSG_HELP_CMD_LANG}"
    echo -e "    ${C_GREEN}:about${C_RESET}                        ${MSG_HELP_CMD_ABOUT:-Muestra los créditos y acerca de YT-CLI}"
    echo -e "    ${C_GREEN}q${C_RESET}                             ${MSG_HELP_CMD_QUIT}\n"
    echo -e "  ${C_YELLOW}${MSG_HELP_CLI_HEADER:-Opciones al arrancar desde terminal externa:}${C_RESET}"
    echo -e "    ${C_CYAN}yt-cli -a <query/url>${C_RESET}               ${MSG_HELP_CLI_AUDIO}"
    echo -e "    ${C_CYAN}yt-cli -d <query/url>${C_RESET}               ${MSG_HELP_CLI_DOWN}"
    echo -e "    ${C_CYAN}yt-cli -m <query/url>${C_RESET}               ${MSG_HELP_CLI_MUSIC}"
    echo -e "    ${C_CYAN}yt-cli -s <query/url>${C_RESET}               ${MSG_HELP_CLI_SPLIT:-Descargar dividiendo en capítulos (álbum/curso)}"
    echo -e "    ${C_CYAN}yt-cli --section <start-end> <url>${C_RESET}     ${MSG_HELP_CLI_SECTION:-Descargar solo un fragmento (ej: --section 00:01:00-00:03:30)}"
    echo -e "    ${C_CYAN}yt-cli -t <query/url>${C_RESET}               ${MSG_HELP_CLI_TRANSCRIPT:-Descargar transcripción de texto / subtítulos}"
    echo -e "    ${C_CYAN}yt-cli -u / --update${C_RESET}                ${MSG_HELP_CLI_UPDATE:-Actualizar yt-dlp y salir}"
    echo -e "    ${C_CYAN}yt-cli -H${C_RESET}                           ${MSG_HELP_CLI_HIST}"
    echo -e "    ${C_CYAN}yt-cli --lang [es|en]${C_RESET}               ${MSG_HELP_CMD_LANG}"
    echo -e "    ${C_CYAN}yt-cli -v / --version${C_RESET}               ${MSG_HELP_CMD_ABOUT:-Muestra los créditos y acerca de YT-CLI}"
    echo -e "    ${C_CYAN}yt-cli -h${C_RESET}                           ${MSG_HELP_CLI_HELP}\n"
    echo -e "${C_CYAN}================================================================${C_RESET}"
    echo -ne "${C_GRAY}${MSG_HELP_PRESS_ENTER:-Presiona [Enter] para volver al menú principal...}${C_RESET}"
    local _dummy=""
    if [ -t 0 ]; then read -r _dummy; else read -r _dummy </dev/tty; fi
}

# 10c. Pantalla de créditos y acerca de
show_about() {
    clear
    echo -e "${C_CYAN}================================================================${C_RESET}"
    echo -e "${C_BOLD}                   ${MSG_ABOUT_TITLE:-ACERCA DE YT-CLI / CRÉDITOS}${C_RESET}"
    echo -e "${C_CYAN}================================================================${C_RESET}\n"
    echo -e "  ${C_YELLOW}${MSG_ABOUT_VERSION:-Versión:}${C_RESET}      ${C_BOLD}v1.7${C_RESET}"
    echo -e "  ${C_YELLOW}${MSG_ABOUT_AUTHOR:-Autor:}${C_RESET}        ${C_GREEN}Kenny Waddell (@KennyWaddell)${C_RESET}"
    echo -e "  ${C_YELLOW}${MSG_ABOUT_COLLAB:-Colaboración:}${C_RESET} Google DeepMind / Antigravity"
    echo -e "  ${C_YELLOW}${MSG_ABOUT_LICENSE:-Licencia:}${C_RESET}     GNU General Public License v3.0 (GPLv3)"
    echo -e "  ${C_YELLOW}${MSG_ABOUT_REPO:-Repositorio:}${C_RESET}  ${C_CYAN}https://github.com/KennyWaddell/yt-cli${C_RESET}\n"
    echo -e "  ${C_GRAY}${MSG_ABOUT_TAGLINE:-Dedicado a la comunidad de Linux y usuarios de hardware modesto.}${C_RESET}\n"
    echo -e "${C_CYAN}================================================================${C_RESET}"
    echo -ne "${C_GRAY}${MSG_HELP_PRESS_ENTER:-Presiona [Enter] para volver al menú principal...}${C_RESET}"
    local _dummy=""
    if [ -t 0 ]; then read -r _dummy; else read -r _dummy </dev/tty; fi
}

# 11. Punto de entrada principal
main() {
    check_dependencies

    # Procesar argumentos por línea de comandos
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                echo "Uso: yt-cli [OPCIONES] [BÚSQUEDA o ENLACE]"
                echo ""
                echo "Opciones:"
                echo "  -c, --cookies [navegador/ruta] Usar cookies para contenido restringido (ej: brave, firefox, cookies.txt)"
                echo "  -a, --audio [query/url]       Reproducir solo el audio (Modo podcast)"
                echo "  -d, --download [query/url]    Descargar video directamente en 720p MP4"
                echo "  -m, --music [query/url]       Descargar audio en MP3, M4A, Opus o FLAC"
                echo "  -s, --split [query/url]       Descargar dividiendo en capítulos (MP3 / Video)"
                echo "      --section [ini-fin] [url] Descargar solo un fragmento (ej: --section 00:01:00-00:03:30)"
                echo "  -t, --transcript [query/url]  Extraer transcripción de texto / subtítulos (.txt y .srt)"
                echo "  -u, --update                  Actualizar yt-dlp a la última versión oficial"
                echo "  -H, --history                 Abrir el historial de vídeos vistos"
                echo "      --clear-history           Borrar todo el historial guardado"
                echo "      --clear-archive           Reiniciar el registro de vídeos ya descargados"
                echo "      --fps [30|60|auto]        Límite de FPS en reproducción (por defecto 30)"
                echo "      --limit [1-200]           Cantidad de resultados por búsqueda (por defecto 25)"
                echo "      --min-duration [dur]      Duración mínima (ej: 5m, 15m, 1h)"
                echo "      --max-duration [dur]      Duración máxima (ej: 10m, 1h)"
                echo "  -sb,--sponsorblock            Omitir patrocinadores al descargar (SponsorBlock)"
                echo "      --sb-profile [modo]       Perfil SponsorBlock: basic | standard | all"
                echo "      --sb-mark                 Marcar capítulos SponsorBlock al reproducir en MPV"
                echo "      --lang [código]           Configurar idioma / Set language"
                echo "  -v, --version, --about        Mostrar versión y créditos / Show credits"
                echo "  -h, --help                    Mostrar esta ayuda"
                echo ""
                echo "Ejemplos:"
                echo "  yt-cli                        Modo interactivo completo (con autodetección de portapapeles)"
                echo "  yt-cli \"@ElCuriosoBen\"        Ver videos recientes de un canal"
                echo "  yt-cli \"@DrossRotzank terror\" Buscar dentro de un canal específico"
                echo "  yt-cli -c brave               Iniciar modo interactivo con cookies de Brave"
                echo "  yt-cli -c brave \"video 18+\"   Buscar con cookies de sesión activadas"
                echo "  yt-cli -H                     Abrir el historial para reanudar cualquier vídeo"
                echo "  yt-cli \"noticias\"            Buscar directamente y elegir del menú"
                echo "  yt-cli -m \"linkin park\"       Buscar y descargar en MP3 directo a tu carpeta Música"
                echo "  yt-cli -s \"pink floyd album\"  Descargar álbum dividiéndolo en canciones individuales"
                echo "  yt-cli --section 00:01:00-00:05:00 \"https://youtu.be/...\"  Descargar solo ese fragmento"
                echo "  yt-cli -t \"conferencia ted\"   Descargar solo la transcripción en texto sin video"
                echo "  yt-cli -u                     Actualizar yt-dlp"
                echo "  yt-cli https://youtu.be/...   Opciones directas para un enlace"
                exit 0
                ;;
            -v|--version|--about)
                echo "YT-CLI v1.7"
                echo "Autor: Kenny Waddell (@KennyWaddell)"
                echo "Colaboración: Google DeepMind / Antigravity"
                echo "Licencia: GNU General Public License v3.0 (GPLv3)"
                echo "Repositorio: https://github.com/KennyWaddell/yt-cli"
                exit 0
                ;;
            -c|--cookies)
                if [ $# -gt 1 ]; then
                    set_cookies "$2"
                    shift 2
                else
                    echo -e "${C_RED}[ERROR]${C_RESET} ${MSG_COOKIE_BROWSER_EMPTY:-Debes indicar un navegador o ruta a cookies (ej: -c brave, -c firefox, -c cookies.txt)}"
                    exit 1
                fi
                ;;
            --lang)
                if [ $# -gt 1 ]; then
                    set_language "$2"
                    shift 2
                else
                    set_language ""
                    shift 1
                fi
                exit 0
                ;;
            -H|--history)
                show_history_menu
                exit 0
                ;;
            --clear-history)
                clear_history
                exit 0
                ;;
            --clear-archive)
                clear_download_archive
                exit 0
                ;;
            --fps)
                if [ $# -gt 1 ]; then
                    MAX_FPS="${2,,}"
                    FPS_CLI_OVERRIDE=1
                    shift 2
                else
                    shift 1
                fi
                ;;
            -sb|--sponsorblock)
                EXTRA_YTDL_ARGS+=("--sponsorblock-remove" "$SPONSORBLOCK_CATS")
                shift 1
                ;;
            --sb-profile)
                if [ $# -gt 1 ]; then
                    case "${2,,}" in
                        all)      SPONSORBLOCK_CATS="all" ;;
                        standard) SPONSORBLOCK_CATS="sponsor,selfpromo,interaction,intro,outro" ;;
                        basic|*)  SPONSORBLOCK_CATS="sponsor,selfpromo" ;;
                    esac
                    shift 2
                else
                    shift 1
                fi
                ;;
            --sb-mark)
                SPONSORBLOCK_MARK="true"
                shift 1
                ;;
            --min-views)
                if [ $# -gt 1 ]; then
                    FILTER_ARGS+=("--match-filter" "view_count >= $2")
                    shift 2
                else
                    shift 1
                fi
                ;;
            --limit)
                if [ $# -gt 1 ]; then
                    if [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 1 ] && [ "$2" -le 200 ]; then
                        SEARCH_LIMIT="$2"
                    fi
                    shift 2
                else
                    shift 1
                fi
                ;;
            --min-duration)
                if [ $# -gt 1 ]; then
                    local min_sec=""
                    if min_sec=$(parse_duration_to_seconds "$2"); then
                        DURATION_FILTER_EXPR="duration >= ${min_sec}"
                        DURATION_FILTER_LABEL=">= $2"
                    fi
                    shift 2
                else
                    shift 1
                fi
                ;;
            --max-duration)
                if [ $# -gt 1 ]; then
                    local max_sec=""
                    if max_sec=$(parse_duration_to_seconds "$2"); then
                        DURATION_FILTER_EXPR="duration <= ${max_sec}"
                        DURATION_FILTER_LABEL="<= $2"
                    fi
                    shift 2
                else
                    shift 1
                fi
                ;;
            --match-filter)
                if [ $# -gt 1 ]; then
                    FILTER_ARGS+=("--match-filter" "$2")
                    shift 2
                else
                    shift 1
                fi
                ;;
            -u|--update|--update-ytdlp)
                update_ytdlp
                exit 0
                ;;
            -s|--split|--split-chapters)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_chapters "$target"
                    else
                        search_and_play "$target" "down_chapters"
                    fi
                else
                    show_banner
                    echo -ne "${C_CYAN}Buscar en YouTube (Dividir en Capítulos): ${C_RESET}"
                    read -r query
                    [ -n "$query" ] && search_and_play "$query" "down_chapters"
                fi
                exit 0
                ;;
            -t|--transcript|--subs)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_transcript "$target"
                    else
                        search_and_play "$target" "down_transcript"
                    fi
                else
                    show_banner
                    echo -ne "${C_CYAN}Buscar en YouTube (Extraer Transcripción): ${C_RESET}"
                    read -r query
                    [ -n "$query" ] && search_and_play "$query" "down_transcript"
                fi
                exit 0
                ;;
            --section|--fragment)
                shift
                local sec_range=""
                if [ $# -gt 0 ] && [[ "$1" =~ ^[0-9:]+-[0-9:]+$ ]]; then
                    sec_range="$1"
                    shift
                fi
                local s_start=""
                local s_end=""
                if [[ "$sec_range" =~ ^([0-9:]+)-([0-9:]+)$ ]]; then
                    s_start="${BASH_REMATCH[1]}"
                    s_end="${BASH_REMATCH[2]}"
                fi
                local target="$*"
                if [ -n "$target" ]; then
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_section "$s_start" "$s_end" "720" "$target"
                    else
                        search_and_play "$target" "down_section"
                    fi
                else
                    download_section "$s_start" "$s_end" "" ""
                fi
                exit 0
                ;;
            -a|--audio)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        play_videos "audio" "$target"
                    else
                        search_and_play "$target" "audio"
                    fi
                else
                    show_banner
                    echo -ne "${C_CYAN}Buscar en YouTube (Solo Audio): ${C_RESET}"
                    read -r query
                    [ -n "$query" ] && search_and_play "$query" "audio"
                fi
                exit 0
                ;;
            -m|--music)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_music "$target"
                    else
                        search_and_play "$target" "ask"
                    fi
                fi
                exit 0
                ;;
            -d|--download)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_videos "720" "$target"
                    else
                        search_and_play "$target" "ask"
                    fi
                fi
                exit 0
                ;;
            *)
                local target="$*"
                if [[ "$target" =~ ^https?:// ]]; then
                    handle_direct_url "$target"
                    exit 0
                else
                    search_and_play "$target" "ask"
                    exit 0
                fi
                ;;
        esac
    done

    # Comprobar si hay un enlace multimedia en el portapapeles al iniciar
    local clipboard_url
    clipboard_url=$(get_clipboard_url)
    if [ -n "$clipboard_url" ]; then
        show_banner
        echo -e "${C_GREEN}${MSG_CLIPBOARD_DETECTED:-📋 Enlace detectado en el portapapeles:}${C_RESET}"
        echo -e "   ${C_CYAN}${clipboard_url}${C_RESET}\n"
        echo -ne "${C_YELLOW}${MSG_CLIPBOARD_CONFIRM:-¿Deseas abrir este enlace? [S/n] (Enter para Sí): }${C_RESET}"
        local use_clip=""
        if [ -t 0 ]; then read -r use_clip || use_clip="s"; else read -r use_clip </dev/tty || use_clip="s"; fi
        [ -z "$use_clip" ] && use_clip="s"
        echo ""

        if [[ "$use_clip" =~ ^[sSyY]$ ]]; then
            handle_direct_url "$clipboard_url"
        fi
    fi

    # Bucle interactivo normal
    while true; do
        show_banner
        echo -ne "${C_CYAN}${MSG_SEARCH_PROMPT:-Buscar, pegar enlace o comando [:help | :h | :u | :lang | @canal | q]: }${C_RESET}"
        read -r query

        if [ -z "$query" ]; then
            continue
        fi

        if [[ "$query" == "q" || "$query" == "exit" || "$query" == "salir" || "$query" == "quit" ]]; then
            echo -e "${C_GRAY}${MSG_GOODBYE:-Hasta luego.}${C_RESET}"
            break
        fi

        if [[ "$query" == ":help" || "$query" == ":?" || "$query" == "help" || "$query" == "ayuda" || "$query" == ":ayuda" ]]; then
            show_interactive_help
            continue
        fi

        if [[ "$query" == ":u" || "$query" == ":update" || "$query" == "update" || "$query" == "actualizar" || "$query" == ":actualizar" ]]; then
            update_ytdlp
            continue
        fi

        if [[ "$query" == ":clear-archive" || "$query" == ":ca" ]]; then
            clear_download_archive
            sleep 1.2
            continue
        fi

        if [[ "$query" =~ ^:(limit|n)([[:space:]]+.*)?$ ]]; then
            local lim_arg
            lim_arg=$(echo "$query" | awk '{print $2}')
            set_search_limit "$lim_arg"
            sleep 1.0
            continue
        fi

        if [[ "$query" =~ ^:(dur|duration|duracion)([[:space:]]+.*)?$ ]]; then
            local dur_arg
            dur_arg=$(echo "$query" | awk '{print $2}')
            set_duration_filter "$dur_arg"
            sleep 1.0
            continue
        fi

        if [[ "$query" =~ ^:lang([[:space:]]+.*)?$ ]]; then
            local l_arg
            l_arg=$(echo "$query" | awk '{print $2}')
            set_language "$l_arg"
            sleep 1.2
            continue
        fi

        if [[ "$query" == ":about" || "$query" == ":creditos" || "$query" == ":credits" || "$query" == "creditos" || "$query" == "credits" || "$query" == "about" ]]; then
            show_about
            continue
        fi

        if [[ "$query" == ":h" || "$query" == "historial" || "$query" == "history" ]]; then
            show_history_menu
            continue
        fi

        if [[ "$query" == ":clear" || "$query" == "borrar" || "$query" == "clear-history" ]]; then
            clear_history
            sleep 1.5
            continue
        fi

        if [[ "$query" == ":c" || "$query" == "cookies" ]]; then
            echo -ne "${C_CYAN}${MSG_COOKIE_PROMPT:-Introduce navegador o ruta a cookies (ej: brave, firefox, cookies.txt): }${C_RESET}"
            read -r c_input
            if [ -n "$c_input" ]; then
                set_cookies "$c_input"
                sleep 1.2
            fi
            continue
        fi

        if [[ "$query" =~ ^https?:// ]]; then
            handle_direct_url "$query"
        else
            search_and_play "$query" "ask"
        fi

        echo -ne "\n${C_YELLOW}${MSG_PRESS_ENTER_RETRY:-¿Presione [Enter] para otra búsqueda o [q] para salir: }${C_RESET}"
        read -r next_action
        if [[ "$next_action" == "q" || "$next_action" == "exit" || "$next_action" == "quit" ]]; then
            echo -e "${C_GRAY}${MSG_GOODBYE:-Hasta luego.}${C_RESET}"
            break
        fi
    done
}

main "$@"
