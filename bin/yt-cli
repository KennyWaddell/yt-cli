#!/usr/bin/env bash
# ==============================================================================
# YT-CLI: Lightweight YouTube & Multimedia Client for Low-Resource Linux Systems
# Optimization: Intel Celeron / Atom / 2GB RAM / Hardware VA-API decoding
# Backend: yt-dlp + fzf + mpv
# License: GNU General Public License v3.0 (GPLv3)
# ==============================================================================

set -euo pipefail

# ANSI Color Codes
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;90m"
C_BOLD="\033[1m"
C_RESET="\033[0m"

# Binaries resolution (prefer standard system paths, fallback to PATH)
BIN_YTDLP="$(command -v yt-dlp || echo "yt-dlp")"
BIN_FZF="$(command -v fzf || echo "fzf")"
BIN_MPV="$(command -v mpv || echo "mpv")"

# Media target directories (Detect Spanish / English locales automatically)
if [ -d "${HOME}/Descargas" ]; then
    DIR_VIDEOS="${HOME}/Descargas/Videos"
else
    DIR_VIDEOS="${HOME}/Downloads/Videos"
fi

if [ -d "${HOME}/Música" ]; then
    DIR_MUSIC="${HOME}/Música"
elif [ -d "${HOME}/Musica" ]; then
    DIR_MUSIC="${HOME}/Musica"
else
    DIR_MUSIC="${HOME}/Music"
fi

mkdir -p "$DIR_VIDEOS" "$DIR_MUSIC" 2>/dev/null || true

# Signal trap for clean exit
trap 'echo -e "\n${C_GRAY}Saliendo de YT-CLI... Hasta luego.${C_RESET}"; exit 0' SIGINT SIGTERM

# 1. Dependency validation
check_dependencies() {
    local missing=0
    for dep in "$BIN_YTDLP" "$BIN_FZF" "$BIN_MPV"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo -e "${C_RED}[ERROR]${C_RESET} Dependencia faltante: ${C_BOLD}$dep${C_RESET}"
            missing=1
        fi
    done
    if [ "$missing" -eq 1 ]; then
        echo -e "${C_YELLOW}Instale las dependencias faltantes: yt-dlp, fzf y mpv.${C_RESET}"
        exit 1
    fi
}

SELECTED_ACTION="play_720"

# 2. Interactive action menu
choose_action() {
    echo -e "${C_CYAN}¿Qué deseas hacer con este contenido?${C_RESET}"
    echo -e "  ${C_BOLD}── REPRODUCIR (STREAMING AL VUELO) ─────────────────${C_RESET}"
    echo -e "  ${C_BOLD}[1]${C_RESET} Ver en 720p HD a 30fps  ${C_GREEN}(Recomendado GPU VA-API)${C_RESET} ${C_YELLOW}★ Predeterminado${C_RESET}"
    echo -e "  ${C_BOLD}[2]${C_RESET} Ver en 1080p Full HD     ${C_GRAY}(30fps acelerado H.264)${C_RESET}"
    echo -e "  ${C_BOLD}[3]${C_RESET} Ver en 480p / 360p       ${C_GRAY}(Ahorro de datos/CPU)${C_RESET}"
    echo -e "  ${C_BOLD}[4]${C_RESET} Escuchar solo audio      ${C_GRAY}(Modo radio/podcast - ~25MB RAM)${C_RESET}"
    echo ""
    echo -e "  ${C_BOLD}── DESCARGAR Y GUARDAR EN DISCO ────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}[5]${C_RESET} Descargar Video 720p     ${C_GRAY}(MP4 H.264 en ${DIR_VIDEOS})${C_RESET}"
    echo -e "  ${C_BOLD}[6]${C_RESET} Descargar Video 1080p    ${C_GRAY}(MP4 Full HD en ${DIR_VIDEOS})${C_RESET}"
    echo -e "  ${C_BOLD}[7]${C_RESET} Descargar Canción MP3    ${C_GRAY}(Con carátula y metadatos en ${DIR_MUSIC})${C_RESET}"
    echo ""
    echo -ne "${C_YELLOW}Elige opción [1-7] (Enter para ver en 720p): ${C_RESET}"

    local user_opt=""
    if [ -t 0 ]; then
        read -r user_opt || user_opt="1"
    else
        read -r user_opt </dev/tty || user_opt="1"
    fi
    [ -z "$user_opt" ] && user_opt="1"
    echo ""

    case "$user_opt" in
        1) SELECTED_ACTION="play_720" ;;
        2) SELECTED_ACTION="play_1080" ;;
        3) SELECTED_ACTION="play_480" ;;
        4|[aA]) SELECTED_ACTION="play_audio" ;;
        5) SELECTED_ACTION="down_720" ;;
        6) SELECTED_ACTION="down_1080" ;;
        7|[mM]) SELECTED_ACTION="down_mp3" ;;
        *) SELECTED_ACTION="play_720" ;;
    esac
}

# 3. Optimized MPV playback
play_video() {
    local target="$1"
    local quality="${2:-720}"

    local MPV_ARGS=(
        "--script-opts=ytdl_hook-ytdl_path=${BIN_YTDLP}"
        "--msg-level=all=no,statusline=status"
    )

    local url="$target"
    [[ "$url" =~ ^https?:// ]] && url="ytdl://${url}"

    if [ "$quality" = "audio" ]; then
        echo -e "${C_CYAN}▶ Modo Solo Audio (Ahorro de RAM: ~25 MB)...${C_RESET}"
        MPV_ARGS+=(
            "--no-video"
            "--ytdl-format=bestaudio/best"
        )
    else
        local ytdl_fmt=""
        case "$quality" in
            360)
                echo -e "${C_CYAN}▶ Reproduciendo en 360p (H.264 / 30fps)...${C_RESET}"
                ytdl_fmt="bestvideo[vcodec^=avc1][height<=360][fps<=30]+bestaudio/best[vcodec^=avc1][height<=360]/best[height<=360]/best"
                ;;
            480)
                echo -e "${C_CYAN}▶ Reproduciendo en 480p (H.264 / 30fps)...${C_RESET}"
                ytdl_fmt="bestvideo[vcodec^=avc1][height<=480][fps<=30]+bestaudio/best[vcodec^=avc1][height<=480]/best[height<=480]/best"
                ;;
            1080)
                echo -e "${C_CYAN}▶ Reproduciendo en 1080p a 30fps (H.264 VA-API, fallback 720p)...${C_RESET}"
                ytdl_fmt="bestvideo[vcodec^=avc1][height<=1080][fps<=30]+bestaudio/bestvideo[vcodec^=avc1][height<=720][fps<=30]+bestaudio/best[vcodec^=avc1][height<=1080]/best[vcodec^=avc1][height<=720]/best[height<=720]/best"
                ;;
            720|*)
                echo -e "${C_CYAN}▶ Reproduciendo en 720p (H.264 VA-API / <=30fps)...${C_RESET}"
                ytdl_fmt="bestvideo[vcodec^=avc1][height<=720][fps<=30]+bestaudio/best[vcodec^=avc1][height<=720]/best[height<=720]/best"
                ;;
        esac

        MPV_ARGS+=(
            "--hwdec=vaapi"
            "--vo=gpu"
            "--ytdl-format=${ytdl_fmt}"
        )
    fi

    echo -e "${C_GRAY}[Atajos MPV: 'q' cerrar y volver a lista | 'Espacio' pausa | '9/0' volumen | 'f' pantalla completa]${C_RESET}"
    echo ""

    "$BIN_MPV" "${MPV_ARGS[@]}" "$url" || true
    echo ""
}

# 4. Optimized Video Download (MP4 / H.264 / <=30fps)
download_video() {
    local target="$1"
    local height="${2:-720}"

    mkdir -p "$DIR_VIDEOS" 2>/dev/null || true
    echo -e "${C_CYAN}⬇ Descargando Video en ${height}p (Códec H.264 compatible / <=30fps)...${C_RESET}"
    echo -e "${C_GRAY}Guardando en: ${DIR_VIDEOS}/${C_RESET}\n"

    local ytdl_fmt="bestvideo[vcodec^=avc1][height<=${height}][fps<=30]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc1][height<=${height}][fps<=30]+bestaudio/best[height<=${height}]/best"

    "$BIN_YTDLP" \
        -f "${ytdl_fmt}" \
        --merge-output-format mp4 \
        --embed-thumbnail \
        --embed-metadata \
        --no-warnings \
        -o "${DIR_VIDEOS}/%(title)s.%(ext)s" \
        "$target" || true

    echo -e "\n${C_GREEN}✔ Descarga de video finalizada con éxito.${C_RESET}"
    echo -ne "${C_YELLOW}Presione [Enter] para volver a la lista...${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 5. Optimized Music / Audio Download (MP3)
download_music() {
    local target="$1"

    echo -e "${C_CYAN}Calidad de audio para MP3:${C_RESET}"
    echo -e "  ${C_BOLD}[1]${C_RESET} 320 kbps  ${C_GREEN}(Máxima fidelidad)${C_RESET} ${C_YELLOW}★ Predeterminado${C_RESET}"
    echo -e "  ${C_BOLD}[2]${C_RESET} 192 kbps  ${C_GRAY}(Balance calidad y tamaño)${C_RESET}"
    echo -e "  ${C_BOLD}[3]${C_RESET} 128 kbps  ${C_GRAY}(Ahorro de espacio / Ideal para playlists)${C_RESET}"
    echo ""
    echo -ne "${C_YELLOW}Elige calidad [1-3] (Enter para 320k): ${C_RESET}"

    local user_opt=""
    if [ -t 0 ]; then
        read -r user_opt || user_opt="1"
    else
        read -r user_opt </dev/tty || user_opt="1"
    fi
    [ -z "$user_opt" ] && user_opt="1"
    echo ""

    local bitrate="320"
    case "$user_opt" in
        2) bitrate="192" ;;
        3) bitrate="128" ;;
        *) bitrate="320" ;;
    esac

    echo -ne "${C_CYAN}¿Incrustar carátula en los MP3? [S/n] (Enter para Sí): ${C_RESET}"
    local user_cover=""
    if [ -t 0 ]; then
        read -r user_cover || user_cover="s"
    else
        read -r user_cover </dev/tty || user_cover="s"
    fi
    [ -z "$user_cover" ] && user_cover="s"
    echo ""

    local EXTRA_ARGS=()
    if [[ "$user_cover" =~ ^[nN]$ ]]; then
        echo -e "${C_YELLOW}⚡ Modo rápido: Se omitirá la carátula para máxima velocidad en la descarga.${C_RESET}"
    else
        EXTRA_ARGS+=("--embed-thumbnail")
        echo -e "${C_GREEN}✔ Se incrustará la carátula oficial en cada archivo.${C_RESET}"
    fi

    mkdir -p "$DIR_MUSIC" 2>/dev/null || true
    echo -e "${C_CYAN}⬇ Descargando audio en MP3 a ${bitrate} kbps...${C_RESET}"
    echo -e "${C_GRAY}Guardando en: ${DIR_MUSIC}/${C_RESET}\n"

    "$BIN_YTDLP" \
        --extract-audio \
        --audio-format mp3 \
        --audio-quality "${bitrate}k" \
        "${EXTRA_ARGS[@]}" \
        --embed-metadata \
        --no-warnings \
        -o "${DIR_MUSIC}/%(playlist_title&{}/|)s%(title)s.%(ext)s" \
        "$target" || true

    echo -e "\n${C_GREEN}✔ Descarga de audio finalizada con éxito en tu carpeta Música.${C_RESET}"
    echo -ne "${C_YELLOW}Presione [Enter] para volver a la lista...${C_RESET}"
    local dummy=""
    if [ -t 0 ]; then read -r dummy; else read -r dummy </dev/tty; fi
}

# 6. Interactive search loop & persistent list
search_and_play() {
    local query="$1"
    local forced_mode="${2:-ask}"

    echo -ne "${C_YELLOW}Buscando en YouTube:${C_RESET} \"${C_BOLD}${query}${C_RESET}\"... \r"

    local search_results
    search_results=$("$BIN_YTDLP" \
        "ytsearch25:${query}" \
        --flat-playlist \
        --skip-download \
        --no-warnings \
        --extractor-args "youtube:player_client=android_creator;lang=es" \
        --print "%(title)s [%(duration_string)s - %(uploader)s]	%(id)s" 2>/dev/null) || true

    if [ -z "$search_results" ]; then
        echo -e "${C_RED}No se encontraron resultados para:${C_RESET} \"$query\""
        return
    fi

    while true; do
        echo -ne "\033[2K\r"

        local selection
        selection=$(echo "$search_results" | "$BIN_FZF" \
            --delimiter='\t' \
            --with-nth=1 \
            --prompt="▶ Selecciona video > " \
            --header="[Enter] Opciones | [ESC] Salir de esta lista y buscar otra cosa | [Flechas] Navegar" \
            --height=70% \
            --reverse \
            --border \
            --info=inline) || true

        if [ -z "$selection" ]; then
            echo -e "${C_GRAY}Saliendo de la lista actual de resultados...${C_RESET}"
            break
        fi

        local video_title
        local video_id
        video_title=$(echo "$selection" | cut -f1)
        video_id=$(echo "$selection" | cut -f2)
        local video_url="https://www.youtube.com/watch?v=${video_id}"

        echo -e "\n${C_GREEN}✔ Seleccionado:${C_RESET} ${C_BOLD}${video_title}${C_RESET}\n"

        if [ "$forced_mode" = "ask" ]; then
            choose_action
            case "$SELECTED_ACTION" in
                play_720)   play_video "$video_url" "720" ;;
                play_1080)  play_video "$video_url" "1080" ;;
                play_480)   play_video "$video_url" "480" ;;
                play_audio) play_video "$video_url" "audio" ;;
                down_720)   download_video "$video_url" "720" ;;
                down_1080)  download_video "$video_url" "1080" ;;
                down_mp3)   download_music "$video_url" ;;
            esac
        else
            play_video "$video_url" "$forced_mode"
        fi
    done
}

# 7. Banner
show_banner() {
    clear
    echo -e "${C_CYAN}  ██╗   ██╗████████╗      ██████╗██╗     ██╗${C_RESET}"
    echo -e "${C_CYAN}  ╚██╗ ██╔╝╚══██╔══╝     ██╔════╝██║     ██║${C_RESET}"
    echo -e "${C_CYAN}   ╚████╔╝    ██║  █████╗██║     ██║     ██║${C_RESET}"
    echo -e "${C_CYAN}    ╚██╔╝     ██║  ╚════╝██║     ██║     ██║${C_RESET}"
    echo -e "${C_CYAN}     ██║      ██║        ╚██████╗███████╗██║${C_RESET}"
    echo -e "${C_GRAY}  ────────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}Cliente Multimedia: YouTube, TikTok, X, Reels y +1000 sitios${C_RESET}"
    echo -e "  ${C_GRAY}Streaming VA-API • Descargas MP4 (H.264) & MP3 320k${C_RESET}"
    echo -e "${C_GRAY}  ────────────────────────────────────────────${C_RESET}\n"
}

# 8. Main Entrypoint
main() {
    check_dependencies

    if [ $# -gt 0 ]; then
        case "$1" in
            -h|--help)
                echo "Uso: yt-cli [OPCIONES] [BÚSQUEDA o ENLACE]"
                echo ""
                echo "Opciones:"
                echo "  -a, --audio [query/url]     Reproducir solo el audio (Modo podcast)"
                echo "  -d, --download [query/url]  Descargar video directamente en 720p MP4"
                echo "  -m, --music [query/url]     Descargar canción directamente en MP3 320k"
                echo "  -h, --help                  Mostrar esta ayuda"
                echo ""
                echo "Ejemplos:"
                echo "  yt-cli                      Modo interactivo completo (ver/descargar)"
                echo "  yt-cli \"noticias\"          Buscar directamente y elegir del menú"
                echo "  yt-cli -m \"linkin park\"     Buscar y descargar en MP3 directo a tu carpeta Música"
                echo "  yt-cli https://youtu.be/... Opciones directas para un enlace"
                exit 0
                ;;
            -a|--audio)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        play_video "$target" "audio"
                    else
                        search_and_play "$target" "audio"
                    fi
                else
                    show_banner
                    echo -ne "${C_CYAN}Buscar en YouTube (Solo Audio): ${C_RESET}"
                    read -r query
                    [ -n "$query" ] && search_and_play "$query" "audio"
                fi
                exit 0
                ;;
            -m|--music)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_music "$target"
                    else
                        search_and_play "$target" "ask"
                    fi
                fi
                exit 0
                ;;
            -d|--download)
                shift
                if [ $# -gt 0 ]; then
                    local target="$*"
                    if [[ "$target" =~ ^https?:// ]]; then
                        download_video "$target" "720"
                    else
                        search_and_play "$target" "ask"
                    fi
                fi
                exit 0
                ;;
            *)
                local target="$*"
                if [[ "$target" =~ ^https?:// ]]; then
                    choose_action
                    case "$SELECTED_ACTION" in
                        play_720)   play_video "$target" "720" ;;
                        play_1080)  play_video "$target" "1080" ;;
                        play_480)   play_video "$target" "480" ;;
                        play_audio) play_video "$target" "audio" ;;
                        down_720)   download_video "$target" "720" ;;
                        down_1080)  download_video "$target" "1080" ;;
                        down_mp3)   download_music "$target" ;;
                    esac
                    exit 0
                else
                    search_and_play "$target" "ask"
                    exit 0
                fi
                ;;
        esac
    fi

    while true; do
        show_banner
        echo -ne "${C_CYAN}Buscar en YouTube o pegar enlace (TikTok, X, etc.) ['q' salir]: ${C_RESET}"
        read -r query

        if [ -z "$query" ]; then
            continue
        fi

        if [[ "$query" == "q" || "$query" == "exit" || "$query" == "salir" ]]; then
            echo -e "${C_GRAY}Hasta luego.${C_RESET}"
            break
        fi

        if [[ "$query" =~ ^https?:// ]]; then
            choose_action
            case "$SELECTED_ACTION" in
                play_720)   play_video "$query" "720" ;;
                play_1080)  play_video "$query" "1080" ;;
                play_480)   play_video "$query" "480" ;;
                play_audio) play_video "$query" "audio" ;;
                down_720)   download_video "$query" "720" ;;
                down_1080)  download_video "$query" "1080" ;;
                down_mp3)   download_music "$query" ;;
            esac
        else
            search_and_play "$query" "ask"
        fi

        echo -ne "\n${C_YELLOW}¿Presione [Enter] para otra búsqueda o [q] para salir: ${C_RESET}"
        read -r next_action
        if [[ "$next_action" == "q" || "$next_action" == "exit" ]]; then
            break
        fi
    done
}

main "$@"
